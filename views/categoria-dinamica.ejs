<!DOCTYPE html>
<html lang="pt-br">
<head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QJ7GX28055"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QJ7GX28055');
    </script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contrataê - <%= categoriaNome %></title>

    <link rel="stylesheet" href="/css/style_laranja_preto.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/pintores.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        .dynamic-category-page .professionals-grid {
            grid-template-columns: repeat(auto-fit, minmax(260px, 280px));
            justify-content: center;
        }
        .dynamic-category-page .professional-card { width: 100%; }
    </style>
</head>
<body>

    <% const bannerEsq = typeof banners !== 'undefined' && banners.find(b => Number(b.posicao) === 3 || Number(b.position) === 3); %>
    <% if (bannerEsq) { %>
    <div class="banner-lateral banner-esquerda" id="banner-mov">
        <button class="close-banner" title="Fechar anúncio">&times;</button>
        <div class="banner-content" data-link="<%= bannerEsq.link_destino || bannerEsq.link_destination || '#' %>">
            <img src="<%= bannerEsq.imagem_url || bannerEsq.image_url %>" alt="<%= bannerEsq.titulo || bannerEsq.title || 'Anúncio' %>">
        </div>
    </div>
    <% } %>

    <% const bannerDir = typeof banners !== 'undefined' && banners.find(b => Number(b.posicao) === 4 || Number(b.position) === 4); %>
    <% if (bannerDir) { %>
    <div class="banner-lateral banner-direita" id="banner-speed">
        <button class="close-banner" title="Fechar anúncio">&times;</button>
        <div class="banner-content" data-link="<%= bannerDir.link_destino || bannerDir.link_destination || '#' %>">
            <img src="<%= bannerDir.imagem_url || bannerDir.image_url %>" alt="<%= bannerDir.titulo || bannerDir.title || 'Anúncio' %>">
        </div>
    </div>
    <% } %>

    <%- include('partials/top-status-bar') %>
    <%- include('partials/header', { currentPage: currentPage }) %>

    <main class="dynamic-category-page">
        <div class="container" style="margin-top: 10px; margin-bottom: 40px;">
            <h2 class="section-title" style="text-align: center;"><%= categoriaNome %> Disponíveis</h2>

            <div class="materials-alert-wrapper">
                <a href="#parceiros-area" class="materials-alert">
                    <div style="display: flex; align-items: center;">
                        <i class="fa-solid fa-briefcase mat-icon" style="margin-right: 15px;"></i>
                        <div class="mat-content">
                            <h4>Precisa de materiais ou apoio?</h4>
                            <p>Veja ofertas de parceiros</p>
                        </div>
                    </div>
                    <i class="fas fa-chevron-down" style="color: #666; margin-left: 15px;"></i>
                </a>
            </div>

            <div class="professionals-grid">
                <% if (!profissionais || profissionais.length === 0) { %>
                    <div style="text-align: center; width: 100%; padding: 40px; color: #ccc; grid-column: 1 / -1;">
                        <i class="fas fa-user-slash" style="font-size: 3rem; margin-bottom: 15px; color: #555;"></i>
                        <h3>Nenhum profissional encontrado nesta categoria.</h3>
                        <p>Tente novamente mais tarde.</p>
                    </div>
                <% } else { %>
                    <% profissionais.forEach(function(profissional) { %>
                        <div class="professional-card">
                            <div class="card-header-img">
                                <img src="<%= profissional.foto || profissional.foto_url || profissional.users?.avatar_url || '/imagens/equipe_site/Mascote.png' %>" alt="<%= profissional.nome || profissional.users?.full_name || 'Profissional Contrataê' %>">
                            </div>
                            <div class="card-body">
                                <h3><%= profissional.nome || profissional.users?.full_name || 'Profissional Contrataê' %></h3>
                                <p class="profissao-tag"><%= categoriaNome || profissional.profissao || 'Profissional' %></p>
                                <div class="rating">
                                    <i class="fas fa-star" style="color: gold;"></i> <%= profissional.avaliacao || '5.0' %>
                                </div>
                                <div class="card-actions">
                                    <a href="#" 
                                       class="button primary-button contact-professional" 
                                       data-professional-id="<%= profissional.id || profissional.user_id %>"
                                       data-profession="<%= categoriaNome || profissional.profissao || profissional.categoria || 'Profissional' %>">
                                            <i class="fab fa-whatsapp"></i> Contatar
                                    </a>
                                    <a href="/perfil/<%= profissional.id || profissional.user_id %>" class="button secondary-button">Ver Perfil</a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>

                <div class="ver-todos-container">
                    <a href="/categoria/outros" class="button secondary-button" style="padding: 10px 40px;">
                        Ver Todos os Profissionais <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </main>

    <nav class="mobile-bottom-nav mobile-only">
        <a href="/" class="nav-item"><i class="fas fa-home"></i><span>Início</span></a>
        <a href="/#busca-rapida" class="nav-item"><i class="fas fa-search"></i><span>Busca</span></a>
        <button class="nav-item" id="mobile-menu-trigger"><i class="fas fa-bars"></i><span>Menu</span></button>
        <a href="/auth/login" class="nav-item"><i class="fas fa-user"></i><span>Entrar</span></a>
    </nav>

    <%- include('partials/footer') %>
</body>
</html>
