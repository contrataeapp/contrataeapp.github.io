<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profissional.nome || profissional.users?.full_name || 'Profissional Contrataê' %> - Contrataê</title>
    <link rel="stylesheet" href="/css/style_laranja_preto.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        /* v11.3.19: a página de perfil público usa o mesmo cabeçalho das categorias.
           Estes estilos ficam isolados abaixo para não quebrar index/categorias. */
        .perfil-container { max-width: 1120px; margin: 36px auto 56px; padding: 0 20px; }
        .profile-browse-nav{position:sticky;top:12px;z-index:1550;display:inline-flex;align-items:center;margin:0 0 22px;max-width:100%;filter:drop-shadow(0 10px 22px rgba(0,0,0,.28))}.profile-browse-nav a{display:inline-flex;align-items:center;gap:8px;max-width:100%;color:#e9edf3;text-decoration:none;font-weight:800;background:rgba(24,25,28,.94);border:1px solid #363a41;border-radius:999px;padding:9px 13px;backdrop-filter:blur(8px);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.profile-browse-nav a:hover{color:#ffb020;border-color:#7d5b1d}.profile-browse-nav a i{color:#ffb020}.continue-browsing{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:38px 0 0;padding:18px 20px;border:1px solid #333;border-radius:16px;background:#191919}.continue-browsing strong{display:block;color:#fff;margin-bottom:5px}.continue-browsing p{margin:0;color:#aeb5bf;font-size:13px;line-height:1.45}.continue-browsing a{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#292b30;border:1px solid #444;color:#fff;border-radius:10px;padding:11px 14px;text-decoration:none;font-weight:800;white-space:nowrap}.continue-browsing a:hover{border-color:#ffa500;color:#ffb020}
        .profile-location-card{margin-top:14px;padding-top:14px;border-top:1px solid #343434}.profile-location-card strong{display:block;color:#ffb020;margin-bottom:7px;font-size:13px}.profile-location-card p{margin:0 0 9px;color:#d8dde4;font-size:13px;line-height:1.45}.profile-location-link,.profile-fixed-phone{display:inline-flex;align-items:center;gap:7px;color:#fff;text-decoration:none;border:1px solid #41454c;background:#191b1f;border-radius:9px;padding:8px 10px;font-size:12px;font-weight:800;margin:4px 5px 0 0}.profile-location-link:hover,.profile-fixed-phone:hover{border-color:#ffb020;color:#ffb020}
        .perfil-header { margin-bottom: 24px; }
        .perfil-header h1 { font-size: 26px; color: #fff; margin-bottom: 8px; text-align:center; }
        .perfil-meta { display: flex; gap: 16px; color: #ccc; font-size: 14px; justify-content:center; flex-wrap:wrap; }
        .perfil-meta span { display: flex; align-items: center; gap: 4px; }
        .perfil-meta .rating { color: #ffa500; font-weight: bold; }
        .gallery-shell{position:relative;max-width:1040px;margin:0 auto 32px;min-width:0}
        .gallery-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(170px, .8fr) minmax(170px, .8fr); grid-template-rows: 210px 210px; gap: 8px; border-radius: 12px; overflow: hidden; background:#111; max-width: 1040px; min-width:0; }
        .gallery-cell{position:relative;min-width:0;min-height:0;background:#0b0b0c;overflow:hidden}.gallery-cell.main-img{grid-row:span 2}.gallery-cell .gallery-item{width:100%;height:100%;object-fit:contain;object-position:center center;cursor:pointer;transition:.3s;background:#0b0b0c;display:block}.gallery-cell:hover .gallery-item{filter:brightness(.82)}
        .gallery-photo-badge{position:absolute;left:12px;top:12px;z-index:3;display:inline-flex;align-items:center;gap:6px;padding:7px 9px;border-radius:999px;background:rgba(17,17,17,.82);border:1px solid rgba(255,176,32,.55);color:#ffd27d;font-size:11px;font-weight:800;pointer-events:none}
        .gallery-caption{position:absolute;left:8px;right:8px;bottom:8px;z-index:2;background:rgba(0,0,0,.72);border-radius:8px;padding:6px 8px;color:#fff;font-size:11px;line-height:1.35;max-height:48px;overflow:hidden;pointer-events:none}
        .gallery-open-all{position:absolute;right:14px;bottom:14px;z-index:4;display:inline-flex;align-items:center;gap:7px;border:1px solid #444;background:rgba(25,25,25,.94);color:#fff;border-radius:10px;padding:10px 12px;font-weight:800;cursor:pointer}.gallery-open-all:hover{border-color:#ffa500;color:#ffb020}
        .perfil-content { display: grid; grid-template-columns: 2fr 1fr; gap: 80px; }
        .info-section h2 { font-size: 22px; color: #fff; margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid #333; }
        .description { color: #ccc; line-height: 1.6; margin-bottom: 32px; }
        .features-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px; }
        .profession-chip-row{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 24px}
        .profession-chip{border:1px solid #39404a;background:#141922;color:#fff;border-radius:999px;padding:8px 12px;font-size:13px;text-decoration:none;display:inline-flex;align-items:center;gap:6px}.profession-chip:hover{border-color:#ffa500;color:#ffb020;transform:translateY(-1px)}
        .profession-chip .muted{color:#ffb21e}
        .detail-box{background:#1b1b1b;border:1px solid #333;border-radius:12px;padding:14px;margin-bottom:14px;color:#ddd}
        .detail-box strong{display:block;color:#ffa500;margin-bottom:6px}.availability-list{list-style:none;margin:0;padding:0;display:grid;gap:7px}.availability-list li{padding:8px 10px;border-radius:10px;background:#141414;border:1px solid #2a2a2a;color:#e8eef5}
        .profile-photo-safe{object-position:center center !important;}
        .feature-item { display: flex; gap: 16px; align-items: flex-start; }
        .feature-item i { font-size: 24px; color: #ffa500; }
        .feature-text h4 { color: #fff; margin-bottom: 4px; }
        .feature-text p { color: #ccc; font-size: 14px; }
        .booking-card { background: #222; border: 1px solid #333; border-radius: 12px; padding: 24px; box-shadow: 0 6px 16px rgba(0,0,0,0.3); position: sticky; top: 100px; }
        .price-info { font-size: 22px; color: #fff; margin-bottom: 24px; font-family:inherit; font-weight:500; }
        .price-info span { font-family:inherit; font-size:18px; font-weight:500; color:#d5dbe3; }
        .btn-contact { background: #25D366; color: #082b16; width: 100%; padding: 14px; border: none; border-radius: 10px; font-size: 16px; font-weight: 900; cursor: pointer; transition: .22s; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; box-shadow:0 8px 24px rgba(37,211,102,.18); }
        .btn-contact:not(:disabled){animation:whatsappPulse 2.8s ease-in-out infinite}.btn-contact:hover { background: #20c45d; transform: translateY(-2px); }.btn-contact:active{transform:scale(.98)}
        @keyframes whatsappPulse{0%,75%,100%{box-shadow:0 8px 24px rgba(37,211,102,.16)}85%{box-shadow:0 0 0 5px rgba(37,211,102,.18),0 8px 26px rgba(37,211,102,.25)}}
        @media(prefers-reduced-motion:reduce){.btn-contact:not(:disabled){animation:none}}
        
        /* Reviews Section */
        .reviews-section { margin-top: 60px; border-top: 1px solid #333; padding-top: 40px; }
        .review-item { background: #1a1a1a; padding: 20px; border-radius: 12px; margin-bottom: 20px; border: 1px solid #333; }
        .review-header { display: flex; justify-content: space-between; margin-bottom: 10px; }
        .review-user { font-weight: bold; color: #ffa500; }
        .review-rating { color: #ffa500; }
        .review-comment { color: #ccc; font-size: 14px; line-height: 1.5; }
        .btn-review { background: transparent; border: 1px solid #ffa500; color: #ffa500; padding: 10px 20px; border-radius: 8px; cursor: pointer; margin-bottom: 30px; }
        .btn-review:hover { background: #ffa500; color: #000; }

        /* Modal Styles */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 2000; align-items: center; justify-content: center; }
        .modal-content { background: #1e1e1e; padding: 30px; border-radius: 15px; max-width: 500px; width: 90%; border: 1px solid #333; position: relative; }
        .modal-content h2 { color: #ffa500; margin-bottom: 15px; }
        .modal-content p { color: #ccc; margin-bottom: 20px; line-height: 1.5; }
        .modal-close { position: absolute; top: 15px; right: 15px; color: #888; cursor: pointer; font-size: 20px; }
        
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; color: #fff; }
        .form-group select, .form-group textarea { width: 100%; padding: 12px; background: #2c2c2c; border: 1px solid #444; border-radius: 8px; color: white; }
        
        .modal-footer { display: flex; gap: 10px; margin-top: 20px; }
        .btn-modal { flex: 1; padding: 12px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; }
        .btn-modal-primary { background: #ffa500; color: #000; }
        .btn-modal-secondary { background: #333; color: #fff; }


        .security-note{margin-top:16px;color:#cfd4dc;font-size:12px;line-height:1.5;text-align:center}
        .profile-lightbox{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:3200;align-items:center;justify-content:center;padding:24px}
        .profile-lightbox.active{display:flex}
        .profile-lightbox img{max-width:min(1100px,92vw);max-height:82vh;object-fit:contain;border-radius:14px;box-shadow:0 30px 80px rgba(0,0,0,.5);background:#111}
        .lightbox-btn{position:absolute;border:0;background:rgba(255,178,30,.95);color:#111;border-radius:999px;width:44px;height:44px;font-size:18px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center}
        .lightbox-close{top:18px;right:22px}.lightbox-prev{left:24px}.lightbox-next{right:96px}
        .lightbox-count{position:absolute;top:20px;left:50%;transform:translateX(-50%);color:#dce2ea;background:rgba(20,20,20,.82);border:1px solid #333;border-radius:999px;padding:8px 12px;font-size:13px}.lightbox-caption{position:absolute;left:50%;transform:translateX(-50%);bottom:18px;width:min(760px,82vw);text-align:center;color:#fff;background:#1a1b1f;border:1px solid #383838;border-radius:12px;padding:10px 14px;font-size:13px;line-height:1.45;box-shadow:0 10px 28px rgba(0,0,0,.35)}.lightbox-caption:empty{display:none}
        .preview-floating-actions{position:fixed;z-index:4600;right:24px;bottom:18px;display:flex;gap:8px;padding:8px;border:1px solid #5e4518;background:rgba(20,17,11,.94);border-radius:14px;box-shadow:0 16px 42px rgba(0,0,0,.45);backdrop-filter:blur(8px)}.preview-floating-actions a,.preview-floating-actions button{border:0;border-radius:10px;padding:10px 13px;font-weight:900;text-decoration:none;display:inline-flex;align-items:center;gap:7px;cursor:pointer}.preview-floating-actions a{background:#2a2c31;color:#fff;border:1px solid #454952}.preview-floating-actions button{background:#ffb020;color:#111}
        .preview-toolbar{position:sticky;top:0;z-index:4500;background:#17130a;border-bottom:1px solid #7c5819;box-shadow:0 10px 30px rgba(0,0,0,.38)}.preview-toolbar-inner{max-width:1180px;margin:0 auto;padding:12px 18px;display:flex;align-items:center;justify-content:space-between;gap:16px}.preview-toolbar strong{display:block;color:#ffb020;margin-bottom:3px}.preview-toolbar p{margin:0;color:#e7dbc2;font-size:12px}.preview-toolbar-actions{display:flex;gap:9px;flex-wrap:wrap}.preview-toolbar .preview-back,.preview-toolbar button{border:0;border-radius:10px;padding:10px 13px;font-weight:800;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:7px}.preview-toolbar .preview-back{background:#292b31;color:#fff;border:1px solid #434750}.preview-toolbar button{background:#ffb020;color:#111}.preview-mode .profession-chip{pointer-events:none;opacity:.72}.preview-mode .mobile-bottom-nav{display:none!important}.preview-mode .btn-contact{background:#34363c;color:#bfc6d0;cursor:not-allowed}.preview-mode .btn-contact:hover{transform:none;background:#34363c}.preview-watermark{display:inline-flex;align-items:center;gap:6px;border:1px solid #7a5718;background:rgba(255,176,32,.09);color:#ffd27d;border-radius:999px;padding:6px 10px;font-size:12px;margin-top:8px}
        .owner-published-toolbar{position:sticky;top:0;z-index:4700;background:rgba(17,18,21,.98);border-bottom:1px solid #5a4319;box-shadow:0 10px 30px rgba(0,0,0,.36);backdrop-filter:blur(10px)}.owner-published-toolbar-inner{max-width:1180px;margin:0 auto;padding:10px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px}.owner-published-toolbar strong{color:#ffb020;display:block}.owner-published-toolbar p{margin:2px 0 0;color:#cbd2dc;font-size:12px}.owner-published-toolbar a{display:inline-flex;align-items:center;gap:7px;text-decoration:none;background:#ffb020;color:#111;border-radius:10px;padding:10px 13px;font-weight:900;white-space:nowrap}.owner-published-mode .airbnb-header,.owner-published-mode .admin-top-bar,.owner-published-mode .mobile-bottom-nav,.owner-published-mode .profile-browse-nav,.owner-published-mode .continue-browsing,.owner-published-mode .banner-lateral .banner-content,.owner-published-mode .profile-location-link{pointer-events:none}.owner-published-mode .banner-lateral .close-banner{pointer-events:auto}.owner-published-mode .airbnb-header,.owner-published-mode .admin-top-bar,.owner-published-mode .mobile-bottom-nav,.owner-published-mode .profile-browse-nav{opacity:.62}.owner-published-mode .continue-browsing{opacity:.58}.owner-published-mode .profile-location-link{opacity:.58}.owner-published-mode .profession-chip{pointer-events:none}.owner-published-watermark{display:inline-flex;align-items:center;gap:6px;border:1px solid #356242;background:rgba(76,175,80,.08);color:#aee8bb;border-radius:999px;padding:6px 10px;font-size:12px;margin-top:8px}.owner-published-mode .btn-contact{animation:none!important;background:#34363c!important;color:#c7ced8!important;cursor:not-allowed!important;box-shadow:none!important}.owner-published-mode .btn-contact:hover{transform:none!important}.owner-published-mode .btn-review{display:none!important}

        @media (max-width: 768px) {
            .perfil-container { margin-top: 18px; padding: 0 12px; max-width:100%; overflow:hidden; }
            .profile-browse-nav,.continue-browsing{align-items:flex-start;flex-direction:column}.profile-browse-nav span{text-align:left}.continue-browsing a{width:100%;white-space:normal;text-align:center}
            .preview-toolbar-inner{flex-direction:column;align-items:stretch;padding:10px 12px}.preview-toolbar-actions{width:100%;display:grid;grid-template-columns:1fr}.preview-toolbar .preview-back,.preview-toolbar button{width:100%;justify-content:center;text-align:center}.profile-browse-nav{position:fixed;top:auto;left:12px;bottom:calc(76px + env(safe-area-inset-bottom));margin:0;z-index:2600}.profile-browse-nav a{font-size:12px;padding:8px 10px;max-width:calc(100vw - 44px)}
            .gallery-shell{max-width:100%;margin-bottom:24px}.gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; grid-auto-rows: 118px; gap: 7px; max-width: 100%; overflow: visible; background: transparent; border-radius: 0; }
            .gallery-cell{height:118px;border-radius:12px;border:1px solid #2c2c2c}.gallery-cell.main-img { grid-column: 1 / -1; grid-row: auto; height:min(58vw,300px);min-height:190px; }
            .gallery-cell .gallery-item{height:100%;border-radius:12px}.gallery-open-all{position:static;width:100%;justify-content:center;margin-top:10px}.gallery-photo-badge{left:8px;top:8px}.gallery-caption{font-size:10px}
            .perfil-content { grid-template-columns: minmax(0,1fr); gap: 30px; min-width:0}.info-section,.booking-sidebar{min-width:0}
            .booking-card { position: static; }
            .features-grid{grid-template-columns:1fr}.detail-box{min-width:0}.availability-list li{overflow-wrap:anywhere}
            .lightbox-prev{left:12px}.lightbox-next{right:12px}.lightbox-close{right:12px}.profile-lightbox{padding:64px 12px 96px}.profile-lightbox img{max-height:62vh;max-width:92vw}.lightbox-count{top:14px;bottom:auto}.lightbox-caption{bottom:14px;width:calc(100vw - 32px);font-size:12px}.preview-floating-actions{left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));display:grid;grid-template-columns:1fr 1fr}.preview-floating-actions a,.preview-floating-actions button{justify-content:center;padding:11px 8px;font-size:12px}
            .owner-published-toolbar-inner{padding:9px 12px;align-items:flex-start}.owner-published-toolbar p{font-size:10.5px;line-height:1.3}.owner-published-toolbar a{padding:9px 10px;font-size:11px}.owner-published-mode .mobile-bottom-nav{opacity:.42}.owner-published-mode .perfil-container{padding-bottom:96px}
        }
    </style>
</head>
<body class="dark-mode <%= (typeof previewMode !== 'undefined' && previewMode) ? 'preview-mode' : '' %> <%= (typeof ownerPublishedView !== 'undefined' && ownerPublishedView) ? 'owner-published-mode' : '' %>">

    <% if (typeof previewMode !== 'undefined' && previewMode) { %>
    <div class="preview-toolbar">
        <div class="preview-toolbar-inner">
            <div>
                <strong><i class="fas fa-eye"></i> Pré-visualização — ainda não publicado</strong>
                <p>Esta tela usa as alterações que você acabou de preencher e não entra no contador de visitas.</p>
            </div>
            <div class="preview-toolbar-actions">
                <a class="preview-back" href="/profissional/dashboard?tab=profissoes&slot=<%= previewSlot %>&restoreDraft=1"><i class="fas fa-arrow-left"></i> Voltar e editar</a>
                <form method="POST" action="/profissional/profissoes/<%= previewSlot %>/atualizar" style="margin:0">
                    <input type="hidden" name="description" value="<%= previewDraft?.description || '' %>">
                    <input type="hidden" name="specialties" value="<%= previewDraft?.specialties || '' %>">
                    <input type="hidden" name="availability_summary" value="<%= previewDraft?.availability_summary || '' %>">
                    <% if (previewDraft?.service_fee_enabled) { %><input type="hidden" name="service_fee_enabled" value="on"><% } %>
                    <input type="hidden" name="price_value" value="<%= previewDraft?.price_value || '' %>">
                    <input type="hidden" name="average_price" value="<%= previewDraft?.average_price || '' %>">
                    <input type="hidden" name="portfolio_order" value="<%= previewDraft?.portfolio_order || '[]' %>">
                    <button type="submit"><i class="fas fa-upload"></i> Publicar e voltar à Área Profissional</button>
                </form>
            </div>
        </div>
    </div>
    <% } %>
    <% if (typeof previewMode !== 'undefined' && previewMode) { %>
    <div class="preview-floating-actions" aria-label="Ações da pré-visualização">
        <a href="/profissional/dashboard?tab=profissoes&slot=<%= previewSlot %>&restoreDraft=1"><i class="fas fa-arrow-left"></i> Voltar e editar</a>
        <form method="POST" action="/profissional/profissoes/<%= previewSlot %>/atualizar" style="margin:0;display:contents">
            <input type="hidden" name="description" value="<%= previewDraft?.description || '' %>"><input type="hidden" name="specialties" value="<%= previewDraft?.specialties || '' %>"><input type="hidden" name="availability_summary" value="<%= previewDraft?.availability_summary || '' %>"><% if (previewDraft?.service_fee_enabled) { %><input type="hidden" name="service_fee_enabled" value="on"><% } %><input type="hidden" name="price_value" value="<%= previewDraft?.price_value || '' %>"><input type="hidden" name="average_price" value="<%= previewDraft?.average_price || '' %>"><input type="hidden" name="portfolio_order" value="<%= previewDraft?.portfolio_order || '[]' %>">
            <button type="submit"><i class="fas fa-upload"></i> Publicar alterações</button>
        </form>
    </div>
    <% } %>


    <% if (typeof ownerPublishedView !== 'undefined' && ownerPublishedView) { %>
    <div class="owner-published-toolbar" role="status">
        <div class="owner-published-toolbar-inner">
            <div>
                <strong><i class="fas fa-eye"></i> Perfil publicado atual · somente visualização</strong>
                <p>Você está vendo exatamente o que os clientes veem agora. A navegação e as ações do cliente ficam bloqueadas para evitar cliques acidentais.</p>
            </div>
            <a href="/profissional/dashboard?tab=<%= encodeURIComponent(ownerReturnTab || 'portfolio') %>&slot=<%= ownerReturnSlot || profissional.selected_profession_slot || 1 %>"><i class="fas fa-arrow-left"></i> Voltar à Área Profissional</a>
        </div>
    </div>
    <% } %>

    <% const bannerEsq = typeof banners !== 'undefined' && banners.find(b => Number(b.posicao) === 3 || Number(b.position) === 3); %>
    <% if (bannerEsq) { %>
    <div class="banner-lateral banner-esquerda" id="banner-mov">
        <button class="close-banner" title="Fechar anúncio">&times;</button>
        <div class="banner-content" data-link="<%= bannerEsq.link_destino || bannerEsq.link_destination || '#' %>">
            <img src="<%= bannerEsq.imagem_url || bannerEsq.image_url %>" alt="<%= bannerEsq.titulo || bannerEsq.title || 'Anúncio' %>">
        </div>
    </div>
    <% } %>
    <% const bannerDir = typeof banners !== 'undefined' && banners.find(b => Number(b.posicao) === 4 || Number(b.position) === 4); %>
    <% if (bannerDir) { %>
    <div class="banner-lateral banner-direita" id="banner-speed">
        <button class="close-banner" title="Fechar anúncio">&times;</button>
        <div class="banner-content" data-link="<%= bannerDir.link_destino || bannerDir.link_destination || '#' %>">
            <img src="<%= bannerDir.imagem_url || bannerDir.image_url %>" alt="<%= bannerDir.titulo || bannerDir.title || 'Anúncio' %>">
        </div>
    </div>
    <% } %>

    <%- include('partials/top-status-bar') %>
    <%- include('partials/header') %>

    <main class="perfil-container">
        <% const browseCategorySlug = profissional.selected_profession_slug || profissional.categories?.slug || (typeof currentPage !== 'undefined' ? currentPage : ''); %>
        <% const browseCategoryName = profissional.profissao || profissional.categories?.name || 'esta área'; %>
        <% const viewingOwnProfile = Boolean(typeof userId !== 'undefined' && userId && String(userId) === String(profissional.user_id || profissional.id)); %>
        <% if (!(typeof previewMode !== 'undefined' && previewMode) && browseCategorySlug) { %>
        <nav class="profile-browse-nav" aria-label="Navegação entre profissionais">
            <a href="/categoria/<%= encodeURIComponent(browseCategorySlug) %>" data-profile-back data-category-slug="<%= browseCategorySlug %>"><i class="fas fa-arrow-left"></i> Voltar para profissionais de <%= browseCategoryName %></a>
        </nav>
        <% } %>
        <div class="perfil-header">
            <h1><%= profissional.nome || profissional.users?.full_name || 'Profissional Contrataê' %> - <%= profissional.profissao || profissional.categories?.name || 'Profissional' %></h1>
            <div class="perfil-meta">
                <span class="rating"><i class="fas fa-star"></i> <%= (typeof reviews !== 'undefined' && reviews.length > 0) ? (reviews.reduce((acc, r) => acc + Number(r.rating || 0), 0) / reviews.length).toFixed(1) : '5.0' %></span>
                <span><i class="fas fa-map-marker-alt"></i> <%= profissional.city %>, <%= profissional.state %></span>
            </div>
            <% if (typeof previewMode !== 'undefined' && previewMode) { %><div style="text-align:center"><span class="preview-watermark"><i class="fas fa-lock"></i> Somente você está vendo este rascunho</span></div><% } %>
            <% if (typeof ownerPublishedView !== 'undefined' && ownerPublishedView) { %><div style="text-align:center"><span class="owner-published-watermark"><i class="fas fa-shield-halved"></i> Visualização do que está publicado agora</span></div><% } %>
        </div>

        <% const galleryItems = [{ src: profissional.foto || profissional.users?.avatar_url || '/imagens/equipe_site/Mascote.png', caption: 'Foto de perfil', isProfile: true }].concat((typeof portfolio !== 'undefined' ? portfolio : []).filter(item => item && item.image_url).map(item => ({ src:item.image_url, caption:String(item.caption || '').trim(), isProfile:false }))); %>
        <% const galleryImages = galleryItems.map(item => item.src); %>
        <% 
            function formatAvailabilityForDisplay(raw) {
                let text = String(raw || '').trim();
                const normalizedAvailability = text.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                if (normalizedAvailability.includes('era pra ter retirado esta caixa') || normalizedAvailability.includes('substituido por uma funcao de marcar') || normalizedAvailability.includes('substituido por uma funcao de selecionar dias')) text = '';
                if (!text) return ['Disponibilidade a combinar.'];
                const parts = text.split('•').map(p => p.trim()).filter(Boolean);
                const dayNames = ['Seg','Ter','Qua','Qui','Sex','Sáb','Sab','Dom'];
                const normalizeDay = (d) => d === 'Sab' ? 'Sáb' : d;
                let h24Days = [];
                let regularDays = '';
                let regularHours = '';
                const extras = [];
                parts.forEach(part => {
                    const p = part.trim();
                    const h24Match = p.match(/^Atendimento\s*24h\s*em\s*(.+)$/i);
                    if (h24Match) {
                        h24Days = h24Match[1].split(/,| e /).map(x => normalizeDay(x.trim())).filter(Boolean);
                    } else if (!regularDays && dayNames.some(d => new RegExp('\\b' + d + '\\b', 'i').test(p)) && !/às|as|Sábado|Sabado|Domingo|Feriado/i.test(p)) {
                        regularDays = p;
                    } else if (!regularHours && /\d{1,2}:\d{2}\s*(às|as)\s*\d{1,2}:\d{2}/i.test(p)) {
                        regularHours = p.replace(/\bas\b/i, 'às');
                    } else {
                        extras.push(p.replace(/^Sabado:/i, 'Sábado:'));
                    }
                });
                const lines = [];
                if (h24Days.length) lines.push('Atendimento 24 horas: ' + h24Days.join(', '));
                if (regularDays || regularHours) {
                    let cleanDays = regularDays;
                    if (cleanDays && h24Days.length) {
                        cleanDays = cleanDays.split(',').map(x => normalizeDay(x.trim())).filter(d => d && !h24Days.includes(d)).join(', ');
                    }
                    if (cleanDays && regularHours) lines.push('Horário comum: ' + cleanDays + ' das ' + regularHours);
                    else if (cleanDays) lines.push('Horário comum: ' + cleanDays);
                    else if (regularHours) lines.push('Horário comum: ' + regularHours);
                }
                extras.forEach(p => lines.push(p));
                return lines.length ? lines : [text];
            }
            const availabilityLines = formatAvailabilityForDisplay(profissional.availability);
        %>
        <div class="gallery-shell">
            <div class="gallery-grid">
                <% galleryItems.slice(0, 5).forEach(function(item, index) { %>
                    <div class="gallery-cell <%= index === 0 ? 'main-img' : '' %>">
                        <img src="<%= item.src %>" class="gallery-item <%= index === 0 ? 'profile-photo-safe' : '' %>" alt="<%= item.isProfile ? 'Foto de perfil do profissional' : ('Imagem ' + index + ' do portfólio') %>" data-gallery-index="<%= index %>">
                        <% if (item.isProfile) { %><span class="gallery-photo-badge"><i class="fas fa-user"></i> Foto de perfil</span><% } %>
                        <% if (!item.isProfile && item.caption) { %><span class="gallery-caption"><%= item.caption %></span><% } %>
                    </div>
                <% }); %>
            </div>
            <% if (galleryItems.length > 1) { %><button type="button" class="gallery-open-all" id="openAllProfilePhotos"><i class="fas fa-images"></i> Ver portfólio (<%= Math.max(0, galleryItems.length - 1) %> fotos)</button><% } %>
        </div>

        <div class="perfil-content">
            <div class="info-section">
                <h2>Sobre o Profissional</h2>
                <% const slots = Array.isArray(profissional.profession_slots) ? profissional.profession_slots : []; %>
                <% const publicSlots = slots.filter(slot => {
                    const requestStatus = String(slot.requestStatus || (slot.request && slot.request.status) || '').toLowerCase();
                    const cleanSlug = String(slot.slug || '').toLowerCase();
                    const genericOther = ['outros','outro'].includes(cleanSlug);
                    return (requestStatus === 'approved' && !genericOther) || (!slot.statusLabel && !slot.isSuggestion && !genericOther);
                }); %>
                <% if (publicSlots.length) { %>
                    <% if (publicSlots.length > 1) { %><p class="small" style="color:#aab3bf;margin-bottom:10px">Este profissional também atende nestas áreas aprovadas:</p><% } %>
                    <div class="profession-chip-row">
                        <% publicSlots.forEach(function(slot) { %>
                            <% if ((typeof previewMode !== 'undefined' && previewMode) || (typeof ownerPublishedView !== 'undefined' && ownerPublishedView)) { %><span class="profession-chip"><%= slot.slot %>. <%= slot.displayName %></span><% } else { %><a class="profession-chip" href="/perfil/<%= profissional.user_id %>?categoria=<%= slot.slug || '' %>"><%= slot.slot %>. <%= slot.displayName %></a><% } %>
                        <% }); %>
                    </div>
                    <% /* Sugestões ainda em análise ficam totalmente ocultas no perfil público. */ %>
                <% } %>
                <div class="description">
                    <p><%= profissional.description || 'Profissional qualificado pronto para atender suas necessidades com excelência e pontualidade.' %></p>
                </div>

                <div class="detail-box"><strong>Disponibilidade</strong><ul class="availability-list"><% availabilityLines.forEach(function(line) { %><li><%= line %></li><% }); %></ul></div>
                <% const priceLines = String(profissional.price_info || (profissional.price_value ? ('Taxa de visita: R$ ' + Number(profissional.price_value).toFixed(2).replace('.', ',')) : 'Valor a combinar.')).split('•').map(x => x.trim()).filter(Boolean); %>
                <div class="detail-box"><strong>Preço / taxa</strong><ul class="availability-list"><% priceLines.forEach(function(line){ %><li><%= line %></li><% }) %></ul></div>

                <div class="features-grid">
                    <div class="feature-item">
                        <i class="fas fa-check-circle"></i>
                        <div class="feature-text">
                            <h4>Verificado</h4>
                            <p>Identidade e documentos validados pela plataforma.</p>
                        </div>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-tools"></i>
                        <div class="feature-text">
                            <h4>Especialidades</h4>
                            <p><%= profissional.specialties || 'Serviços gerais de alta qualidade.' %></p>
                        </div>
                    </div>
                </div>

                <!-- Seção de Avaliações -->
                <div class="reviews-section">
                    <h2>Avaliações</h2>
                    <% if (typeof previewMode !== 'undefined' && previewMode) { %>
                        <p style="color:#9aa4b2;margin-bottom:20px">Avaliações ficam desativadas durante a pré-visualização.</p>
                    <% } else if (typeof ownerPublishedView !== 'undefined' && ownerPublishedView) { %>
                        <p style="color:#aab3bf;margin-bottom:20px"><i class="fas fa-eye"></i> Somente visualização: as avaliações abaixo são as que estão publicadas para os clientes.</p>
                    <% } else if (viewingOwnProfile) { %>
                        <p style="color:#aab3bf;margin-bottom:20px"><i class="fas fa-shield-halved"></i> Você está vendo seu próprio perfil. Avaliações são feitas por clientes e não podem ser enviadas pelo próprio profissional.</p>
                    <% } else if (typeof userId !== 'undefined' && userId) { %>
                        <button class="btn-review" onclick="showReviewModal()">Deixar uma Avaliação</button>
                    <% } else { %>
                        <p style="color: #888; margin-bottom: 20px;"><a href="/auth/login" style="color: #ffa500;">Faça login</a> para avaliar este profissional.</p>
                    <% } %>

                    <div id="reviewsList">
                        <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
                            <% reviews.filter(r => r.status === 'visible').forEach(review => { %>
                                <div class="review-item">
                                    <div class="review-header">
                                        <span class="review-user">Cliente Verificado</span>
                                        <span class="review-rating">
                                            <% for(let i=0; i<5; i++) { %>
                                                <i class="fas fa-star" style="color: <%= i < review.rating ? '#ffa500' : '#444' %>"></i>
                                            <% } %>
                                        </span>
                                    </div>
                                    <p class="review-comment"><%= review.comment %></p>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p style="color: #666;">Nenhuma avaliação ainda. Seja o primeiro a avaliar!</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="booking-sidebar">
                <div class="booking-card">
                    <div class="price-info">
                        Atendimento em <span><%= profissional.city %></span>
                    </div>
                    <% if (typeof previewMode !== 'undefined' && previewMode) { %>
                    <button type="button" class="btn-contact" disabled><i class="fas fa-eye"></i> Botão de contratação na prévia</button>
                    <% } else if (viewingOwnProfile) { %>
                    <button type="button" class="btn-contact" disabled><i class="fas fa-user-shield"></i> Seu próprio perfil</button>
                    <% } else { %>
                    <button onclick="handleWhatsAppClick()" class="btn-contact" id="profileContactBtn" data-professional-id="<%= profissional.user_id %>" data-profession="<%= profissional.profissao || profissional.categories?.name || 'Profissional' %>">
                        <i class="fab fa-whatsapp"></i> Contratar pelo WhatsApp
                    </button>
                    <% } %>
                    <p class="security-note">Converse pelo fluxo do Contrataê para manter histórico, segurança e controle da contratação.</p>
                    <% const publicAddressParts = [profissional.address_street, profissional.address_number, profissional.address_neighborhood, profissional.city, profissional.state, profissional.cep].filter(Boolean); %>
                    <% if (profissional.show_full_address && publicAddressParts.length >= 3) { %>
                    <div class="profile-location-card">
                        <strong><i class="fas fa-location-dot"></i> Endereço profissional</strong>
                        <p><%= [profissional.address_street, profissional.address_number].filter(Boolean).join(', ') %><% if (profissional.address_neighborhood) { %> · <%= profissional.address_neighborhood %><% } %></p>
                        <% if (typeof ownerPublishedView !== 'undefined' && ownerPublishedView) { %><span class="profile-location-link" aria-disabled="true"><i class="fas fa-map-location-dot"></i> Abrir no Maps</span><% } else { %><a class="profile-location-link" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(publicAddressParts.join(', ')) %>" target="_blank" rel="noopener"><i class="fas fa-map-location-dot"></i> Abrir no Maps</a><% } %>
                    </div>
                    <% } %>
                    <% if (profissional.fixed_phone) { %>
                    <div class="profile-location-card"><strong><i class="fas fa-phone"></i> Telefone</strong><% if (typeof ownerPublishedView !== 'undefined' && ownerPublishedView) { %><span class="profile-fixed-phone" aria-disabled="true"><i class="fas fa-phone"></i> Ligar para o profissional</span><% } else { %><a class="profile-fixed-phone" href="tel:<%= String(profissional.fixed_phone).replace(/\D/g,'') %>"><i class="fas fa-phone"></i> Ligar para o profissional</a><% } %></div>
                    <% } %>
                </div>
            </div>
        </div>
        <% if (!(typeof previewMode !== 'undefined' && previewMode) && browseCategorySlug) { %>
        <div class="continue-browsing">
            <div><strong>Quer comparar antes de contratar?</strong><p>Veja outros profissionais de <%= browseCategoryName %> e escolha com mais segurança.</p></div>
            <a href="/categoria/<%= encodeURIComponent(browseCategorySlug) %>"><i class="fas fa-users"></i> Ver outros <%= browseCategoryName %></a>
        </div>
        <% } %>
    </main>

    <!-- Modal de Segurança WhatsApp -->
    <div id="whatsappModal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="hideModal('whatsappModal')">&times;</span>
            <h2 id="contactModalTitle">Dica de Segurança</h2>
            <p id="contactModalText">Para sua segurança, mantenha a conversa até o término do serviço. Evite pagamentos antecipados sem garantias.</p>
            <p id="contactModalExtra" style="font-size:13px;color:#9aa4b2"></p>
            <div class="modal-footer" id="contactModalActions">
                <a id="whatsappLink" href="#" class="btn-modal btn-modal-primary" style="text-align: center; text-decoration: none;" target="_blank" onclick="hideModal('whatsappModal')">Entendi, ir para o WhatsApp</a>
            </div>
        </div>
    </div>

    <div class="profile-lightbox" id="profileLightbox">
        <button class="lightbox-btn lightbox-close" type="button" onclick="closeProfileLightbox()">&times;</button>
        <button class="lightbox-btn lightbox-prev" type="button" onclick="moveProfileLightbox(-1)"><i class="fas fa-chevron-left"></i></button>
        <img id="profileLightboxImg" src="" alt="Imagem ampliada">
        <button class="lightbox-btn lightbox-next" type="button" onclick="moveProfileLightbox(1)"><i class="fas fa-chevron-right"></i></button>
        <div class="lightbox-caption" id="profileLightboxCaption"></div>
        <div class="lightbox-count" id="profileLightboxCount"></div>
    </div>

    <!-- Modal de Avaliação -->
    <div id="reviewModal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="hideModal('reviewModal')">&times;</span>
            <h2>Avaliar Profissional</h2>
            <p style="font-size: 13px; color: #ff4444;">"Avaliações devem ser feitas com responsabilidade. Comentários ofensivos podem resultar em banimento da conta."</p>
            
            <form id="reviewForm">
                <input type="hidden" name="professional_id" value="<%= profissional.user_id %>">
                <div class="form-group">
                    <label>Sua Nota</label>
                    <select name="rating" required>
                        <option value="5">5 Estrelas - Excelente</option>
                        <option value="4">4 Estrelas - Muito Bom</option>
                        <option value="3">3 Estrelas - Bom</option>
                        <option value="2">2 Estrelas - Regular</option>
                        <option value="1">1 Estrela - Ruim</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Seu Comentário</label>
                    <textarea name="comment" rows="4" placeholder="Conte como foi sua experiência..." required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modal btn-modal-secondary" onclick="hideModal('reviewModal')">Cancelar</button>
                    <button type="submit" class="btn-modal btn-modal-primary">Enviar Avaliação</button>
                </div>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/mobile-bottom-nav', { active: 'perfil' }) %>

    <script>
        function showReviewModal() {
            document.getElementById('reviewModal').style.display = 'flex';
        }

        // Mantém feedback explícito durante a publicação tanto no topo quanto no botão flutuante.
        document.querySelectorAll('.preview-toolbar form, .preview-floating-actions form').forEach(form => {
            form.addEventListener('submit', (event) => {
                const button = event.submitter || form.querySelector('button[type="submit"]');
                if (!button) return;
                button.disabled = true;
                button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processando...';
            });
        });

        const galleryItems = <%- JSON.stringify(galleryItems) %>;
        const galleryImages = galleryItems.map(item => item.src);
        let currentLightboxIndex = 0;

        function openProfileLightbox(index) {
            currentLightboxIndex = Number(index || 0);
            const modal = document.getElementById('profileLightbox');
            syncProfileLightbox();
            modal?.classList.add('active');
        }
        function syncProfileLightbox() {
            const img = document.getElementById('profileLightboxImg');
            const count = document.getElementById('profileLightboxCount');
            const caption = document.getElementById('profileLightboxCaption');
            if (!img || !galleryItems.length) return;
            if (currentLightboxIndex < 0) currentLightboxIndex = galleryItems.length - 1;
            if (currentLightboxIndex >= galleryItems.length) currentLightboxIndex = 0;
            const item = galleryItems[currentLightboxIndex] || {};
            img.src = item.src || '';
            if (caption) caption.textContent = item.caption || (item.isProfile ? 'Foto de perfil' : '');
            if (count) count.textContent = `${currentLightboxIndex + 1} de ${galleryItems.length}`;
        }
        function moveProfileLightbox(direction) { currentLightboxIndex += direction; syncProfileLightbox(); }
        function closeProfileLightbox() { document.getElementById('profileLightbox')?.classList.remove('active'); }
        document.querySelectorAll('[data-gallery-index]').forEach(img => img.addEventListener('click', () => openProfileLightbox(img.dataset.galleryIndex)));
        document.getElementById('openAllProfilePhotos')?.addEventListener('click',()=>openProfileLightbox(0));

        // Se o cliente veio da listagem desta categoria, o botão do próprio site usa
        // o histórico do navegador para voltar exatamente ao ponto onde ele estava.
        // A URL do href continua como fallback para acesso direto ao perfil.
        document.querySelectorAll('[data-profile-back]').forEach(link => {
            link.addEventListener('click', (event) => {
                try {
                    if (!document.referrer) return;
                    const ref = new URL(document.referrer);
                    const slug = String(link.dataset.categorySlug || '').trim();
                    const expectedPath = '/categoria/' + encodeURIComponent(slug);
                    if (ref.origin === window.location.origin && ref.pathname === expectedPath) {
                        event.preventDefault();
                        history.back();
                    }
                } catch (_) {}
            });
        });

        function setContactModal(title, text, extra, mode, data) {
            document.getElementById('contactModalTitle').textContent = title;
            document.getElementById('contactModalText').textContent = text;
            document.getElementById('contactModalExtra').textContent = extra || '';
            const actions = document.getElementById('contactModalActions');
            if (mode === 'login') {
                actions.innerHTML = `<a class="btn-modal btn-modal-secondary" style="text-align:center;text-decoration:none" href="${data.login_url || '/auth/login'}">Entrar</a><a class="btn-modal btn-modal-primary" style="text-align:center;text-decoration:none" href="${data.cadastro_url || '/auth/cadastro-form?type=client'}">Criar conta cliente</a>`;
            } else if (mode === 'whatsapp') {
                actions.innerHTML = `<a id="whatsappLink" href="${data.whatsapp_url || '#'}" class="btn-modal btn-modal-primary" style="text-align:center;text-decoration:none" target="_blank" onclick="hideModal('whatsappModal')">Entendi, ir para o WhatsApp</a>`;
            } else {
                actions.innerHTML = `<button type="button" class="btn-modal btn-modal-primary" onclick="hideModal('whatsappModal')">Entendi</button>`;
            }
            document.getElementById('whatsappModal').style.display = 'flex';
        }

        async function handleWhatsAppClick() {
            const button = document.getElementById('profileContactBtn');
            const original = button?.innerHTML;
            if (button) { button.disabled = true; button.innerHTML = '<i class="fab fa-whatsapp"></i> Preparando WhatsApp...'; }
            try {
                const response = await fetch('/api/contact-leads', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        professional_id: button?.dataset.professionalId || '<%= profissional.user_id %>',
                        profession: button?.dataset.profession || 'Profissional',
                        source_url: window.location.pathname + window.location.search
                    })
                });
                const data = await response.json().catch(() => ({}));
                if (response.status === 401 || data.login_required) {
                    setContactModal('Entre para contratar com segurança', 'Para iniciar o contato, entre ou crie sua conta de cliente. Assim o Contrataê oferece mais segurança e confiança para as duas partes.', '', 'login', data);
                    return;
                }
                if (!response.ok || !data.ok || !data.whatsapp_url) {
                    setContactModal('Contato indisponível', data.message || 'Não foi possível liberar o contato agora.', '', 'info', {});
                    return;
                }
                setContactModal('Dica de Segurança', 'Para sua segurança, mantenha a conversa registrada até o término do serviço. Evite pagamentos antecipados sem garantias.', 'O profissional também será notificado dentro da plataforma.', 'whatsapp', data);
            } catch (err) {
                setContactModal('Erro de conexão', 'Não foi possível liberar o contato agora.', '', 'info', {});
            } finally {
                if (button) { button.disabled = false; button.innerHTML = original; }
            }
        }

        function hideModal(id) {
            document.getElementById(id).style.display = 'none';
        }

        document.getElementById('reviewForm').onsubmit = async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/api/reviews', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                
                if (result.sucesso) {
                    alert(result.mensagem);
                    location.reload();
                } else {
                    alert(result.erro || 'Erro ao enviar avaliação.');
                }
            } catch (err) {
                alert('Erro de conexão.');
            }
        };

        // v11.3.37: no modo proprietário publicado, a página é um espelho somente leitura.
        // A galeria continua navegável para conferência, mas ações/navegação de cliente são bloqueadas.
        <% if (typeof ownerPublishedView !== 'undefined' && ownerPublishedView) { %>
        document.addEventListener('click', function(event){
            const blocked = event.target.closest('.airbnb-header a,.airbnb-header button,.admin-top-bar a,.mobile-bottom-nav a,.mobile-bottom-nav button,.profile-browse-nav a,.continue-browsing a,.banner-lateral .banner-content,.profile-location-link,.profile-fixed-phone,.btn-contact,.btn-review');
            if(blocked){ event.preventDefault(); event.stopPropagation(); }
        }, true);
        document.addEventListener('submit', function(event){
            if(!event.target.closest('.owner-published-toolbar')){ event.preventDefault(); event.stopPropagation(); }
        }, true);
        document.querySelectorAll('.airbnb-header a,.airbnb-header button,.admin-top-bar a,.mobile-bottom-nav a,.mobile-bottom-nav button,.profile-browse-nav a,.continue-browsing a,.profile-location-link,.profile-fixed-phone,.btn-contact,.btn-review').forEach(el=>{ el.setAttribute('aria-disabled','true'); el.setAttribute('tabindex','-1'); });
        <% } %>

        // Fechar modais ao clicar fora
        window.onclick = function(event) {
            if (event.target.className === 'modal') {
                event.target.style.display = 'none';
            }
            if (event.target.id === 'profileLightbox') {
                closeProfileLightbox();
            }
        }
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') closeProfileLightbox();
            if (event.key === 'ArrowLeft') moveProfileLightbox(-1);
            if (event.key === 'ArrowRight') moveProfileLightbox(1);
        });
    </script>
</body>
</html>
