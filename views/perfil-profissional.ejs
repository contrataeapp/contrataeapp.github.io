<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profissional.nome || profissional.users?.full_name || 'Profissional Contrataê' %> - Contrataê</title>
    <link rel="stylesheet" href="/css/style_laranja_preto.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        /* v11.3.19: a página de perfil público usa o mesmo cabeçalho das categorias.
           Estes estilos ficam isolados abaixo para não quebrar index/categorias. */
        .perfil-container { max-width: 1120px; margin: 36px auto 56px; padding: 0 20px; }
        .perfil-header { margin-bottom: 24px; }
        .perfil-header h1 { font-size: 26px; color: #fff; margin-bottom: 8px; text-align:center; }
        .perfil-meta { display: flex; gap: 16px; color: #ccc; font-size: 14px; justify-content:center; flex-wrap:wrap; }
        .perfil-meta span { display: flex; align-items: center; gap: 4px; }
        .perfil-meta .rating { color: #ffa500; font-weight: bold; }
        .gallery-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(170px, .8fr) minmax(170px, .8fr); grid-template-rows: 210px 210px; gap: 8px; border-radius: 12px; overflow: hidden; margin: 0 auto 32px; background:#111; max-width: 1040px; }
        .gallery-item { width: 100%; height: 100%; object-fit: contain; object-position:center center; cursor: pointer; transition: 0.3s; background:#0b0b0c; display:block; }
        .gallery-item:hover { filter: brightness(0.8); }
        .main-img { grid-row: span 2; }
        .perfil-content { display: grid; grid-template-columns: 2fr 1fr; gap: 80px; }
        .info-section h2 { font-size: 22px; color: #fff; margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid #333; }
        .description { color: #ccc; line-height: 1.6; margin-bottom: 32px; }
        .features-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px; }
        .profession-chip-row{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 24px}
        .profession-chip{border:1px solid #39404a;background:#141922;color:#fff;border-radius:999px;padding:8px 12px;font-size:13px;text-decoration:none;display:inline-flex;align-items:center;gap:6px}.profession-chip:hover{border-color:#ffa500;color:#ffb020;transform:translateY(-1px)}
        .profession-chip .muted{color:#ffb21e}
        .detail-box{background:#1b1b1b;border:1px solid #333;border-radius:12px;padding:14px;margin-bottom:14px;color:#ddd}
        .detail-box strong{display:block;color:#ffa500;margin-bottom:6px}.availability-list{list-style:none;margin:0;padding:0;display:grid;gap:7px}.availability-list li{padding:8px 10px;border-radius:10px;background:#141414;border:1px solid #2a2a2a;color:#e8eef5}
        .profile-photo-safe{object-position:center center !important;}
        .feature-item { display: flex; gap: 16px; align-items: flex-start; }
        .feature-item i { font-size: 24px; color: #ffa500; }
        .feature-text h4 { color: #fff; margin-bottom: 4px; }
        .feature-text p { color: #ccc; font-size: 14px; }
        .booking-card { background: #222; border: 1px solid #333; border-radius: 12px; padding: 24px; box-shadow: 0 6px 16px rgba(0,0,0,0.3); position: sticky; top: 100px; }
        .price-info { font-size: 22px; color: #fff; margin-bottom: 24px; }
        .price-info span { font-size: 16px; color: #ccc; font-weight: normal; }
        .btn-contact { background: #ffa500; color: #000; width: 100%; padding: 14px; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; }
        .btn-contact:hover { background: #ff8c00; transform: translateY(-2px); }
        
        /* Reviews Section */
        .reviews-section { margin-top: 60px; border-top: 1px solid #333; padding-top: 40px; }
        .review-item { background: #1a1a1a; padding: 20px; border-radius: 12px; margin-bottom: 20px; border: 1px solid #333; }
        .review-header { display: flex; justify-content: space-between; margin-bottom: 10px; }
        .review-user { font-weight: bold; color: #ffa500; }
        .review-rating { color: #ffa500; }
        .review-comment { color: #ccc; font-size: 14px; line-height: 1.5; }
        .btn-review { background: transparent; border: 1px solid #ffa500; color: #ffa500; padding: 10px 20px; border-radius: 8px; cursor: pointer; margin-bottom: 30px; }
        .btn-review:hover { background: #ffa500; color: #000; }

        /* Modal Styles */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 2000; align-items: center; justify-content: center; }
        .modal-content { background: #1e1e1e; padding: 30px; border-radius: 15px; max-width: 500px; width: 90%; border: 1px solid #333; position: relative; }
        .modal-content h2 { color: #ffa500; margin-bottom: 15px; }
        .modal-content p { color: #ccc; margin-bottom: 20px; line-height: 1.5; }
        .modal-close { position: absolute; top: 15px; right: 15px; color: #888; cursor: pointer; font-size: 20px; }
        
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; color: #fff; }
        .form-group select, .form-group textarea { width: 100%; padding: 12px; background: #2c2c2c; border: 1px solid #444; border-radius: 8px; color: white; }
        
        .modal-footer { display: flex; gap: 10px; margin-top: 20px; }
        .btn-modal { flex: 1; padding: 12px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; }
        .btn-modal-primary { background: #ffa500; color: #000; }
        .btn-modal-secondary { background: #333; color: #fff; }


        .security-note{margin-top:16px;color:#cfd4dc;font-size:12px;line-height:1.5;text-align:center}
        .profile-lightbox{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:3200;align-items:center;justify-content:center;padding:24px}
        .profile-lightbox.active{display:flex}
        .profile-lightbox img{max-width:min(1100px,92vw);max-height:82vh;object-fit:contain;border-radius:14px;box-shadow:0 30px 80px rgba(0,0,0,.5);background:#111}
        .lightbox-btn{position:absolute;border:0;background:rgba(255,178,30,.95);color:#111;border-radius:999px;width:44px;height:44px;font-size:18px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center}
        .lightbox-close{top:18px;right:22px}.lightbox-prev{left:24px}.lightbox-next{right:96px}
        .lightbox-count{position:absolute;bottom:22px;color:#dce2ea;background:rgba(20,20,20,.78);border:1px solid #333;border-radius:999px;padding:8px 12px;font-size:13px}

        @media (max-width: 768px) {
            .perfil-container { margin-top: 24px; padding: 0 14px; }
            .gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; grid-auto-rows: 118px; gap: 7px; max-width: 100%; overflow: visible; background: transparent; border-radius: 0; }
            .gallery-item { display: block !important; height: 118px; border-radius: 12px; border: 1px solid #2c2c2c; object-fit: contain; background: #0b0b0c; }
            .main-img { grid-column: 1 / -1; grid-row: auto; height: min(58vh, 390px); }
            .perfil-content { grid-template-columns: 1fr; gap: 30px; }
            .booking-card { position: static; }
            .lightbox-next{right:86px}
            .profile-lightbox{padding:14px 14px 72px}.profile-lightbox img{max-height:76vh}.lightbox-count{bottom:18px}
        }
    </style>
</head>
<body class="dark-mode">
    <%- include('partials/top-status-bar') %>
    <%- include('partials/header') %>

    <main class="perfil-container">
        <div class="perfil-header">
            <h1><%= profissional.nome || profissional.users?.full_name || 'Profissional Contrataê' %> - <%= profissional.profissao || profissional.categories?.name || 'Profissional' %></h1>
            <div class="perfil-meta">
                <span class="rating"><i class="fas fa-star"></i> <%= (typeof reviews !== 'undefined' && reviews.length > 0) ? (reviews.reduce((acc, r) => acc + Number(r.rating || 0), 0) / reviews.length).toFixed(1) : '5.0' %></span>
                <span><i class="fas fa-map-marker-alt"></i> <%= profissional.city %>, <%= profissional.state %></span>
            </div>
        </div>

        <% const galleryImages = [profissional.foto || profissional.users?.avatar_url || '/imagens/equipe_site/Mascote.png'].concat((typeof portfolio !== 'undefined' ? portfolio : []).map(item => item.image_url).filter(Boolean)); %>
        <% 
            function formatAvailabilityForDisplay(raw) {
                const text = String(raw || '').trim();
                if (!text) return ['Disponibilidade a combinar.'];
                const parts = text.split('•').map(p => p.trim()).filter(Boolean);
                const dayNames = ['Seg','Ter','Qua','Qui','Sex','Sáb','Sab','Dom'];
                const normalizeDay = (d) => d === 'Sab' ? 'Sáb' : d;
                let h24Days = [];
                let regularDays = '';
                let regularHours = '';
                const extras = [];
                parts.forEach(part => {
                    const p = part.trim();
                    const h24Match = p.match(/^Atendimento\s*24h\s*em\s*(.+)$/i);
                    if (h24Match) {
                        h24Days = h24Match[1].split(/,| e /).map(x => normalizeDay(x.trim())).filter(Boolean);
                    } else if (!regularDays && dayNames.some(d => new RegExp('\b' + d + '\b', 'i').test(p)) && !/às|as|Sábado|Sabado|Domingo|Feriado/i.test(p)) {
                        regularDays = p;
                    } else if (!regularHours && /\d{1,2}:\d{2}\s*(às|as)\s*\d{1,2}:\d{2}/i.test(p)) {
                        regularHours = p.replace(/\bas\b/i, 'às');
                    } else {
                        extras.push(p.replace(/^Sabado:/i, 'Sábado:'));
                    }
                });
                const lines = [];
                if (h24Days.length) lines.push('Atendimento 24 horas: ' + h24Days.join(', '));
                if (regularDays || regularHours) {
                    let cleanDays = regularDays;
                    if (cleanDays && h24Days.length) {
                        cleanDays = cleanDays.split(',').map(x => normalizeDay(x.trim())).filter(d => d && !h24Days.includes(d)).join(', ');
                    }
                    if (cleanDays && regularHours) lines.push('Horário comum: ' + cleanDays + ' das ' + regularHours);
                    else if (cleanDays) lines.push('Horário comum: ' + cleanDays);
                    else if (regularHours) lines.push('Horário comum: ' + regularHours);
                }
                extras.forEach(p => lines.push(p));
                return lines.length ? lines : [text];
            }
            const availabilityLines = formatAvailabilityForDisplay(profissional.availability);
        %>
        <div class="gallery-grid">
            <% galleryImages.slice(0, 5).forEach(function(src, index) { %>
                <img src="<%= src %>" class="gallery-item <%= index === 0 ? 'main-img profile-photo-safe' : '' %>" alt="Imagem <%= index + 1 %> do perfil" data-gallery-index="<%= index %>">
            <% }); %>
        </div>

        <div class="perfil-content">
            <div class="info-section">
                <h2>Sobre o Profissional</h2>
                <% const slots = Array.isArray(profissional.profession_slots) ? profissional.profession_slots : []; %>
                <% const publicSlots = slots.filter(slot => !slot.statusLabel && !slot.isSuggestion && !['outros','outro'].includes(String(slot.slug || '').toLowerCase())); %>
                <% if (publicSlots.length) { %>
                    <div class="profession-chip-row">
                        <% publicSlots.forEach(function(slot) { %>
                            <a class="profession-chip" href="/categoria/<%= slot.slug || '' %>"><%= slot.slot %>. <%= slot.displayName %></a>
                        <% }); %>
                    </div>
                    <% /* Sugestões ainda em análise ficam totalmente ocultas no perfil público. */ %>
                <% } %>
                <div class="description">
                    <p><%= profissional.description || 'Profissional qualificado pronto para atender suas necessidades com excelência e pontualidade.' %></p>
                </div>

                <div class="detail-box"><strong>Disponibilidade</strong><ul class="availability-list"><% availabilityLines.forEach(function(line) { %><li><%= line %></li><% }); %></ul></div>
                <div class="detail-box"><strong>Preço / taxa</strong><%= profissional.price_info || (profissional.price_value ? ('Taxa de visita: R$ ' + Number(profissional.price_value).toFixed(2).replace('.', ',')) : 'Valor a combinar.') %></div>

                <div class="features-grid">
                    <div class="feature-item">
                        <i class="fas fa-check-circle"></i>
                        <div class="feature-text">
                            <h4>Verificado</h4>
                            <p>Identidade e documentos validados pela plataforma.</p>
                        </div>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-tools"></i>
                        <div class="feature-text">
                            <h4>Especialidades</h4>
                            <p><%= profissional.specialties || 'Serviços gerais de alta qualidade.' %></p>
                        </div>
                    </div>
                </div>

                <!-- Seção de Avaliações -->
                <div class="reviews-section">
                    <h2>Avaliações</h2>
                    <% if (typeof userId !== 'undefined' && userId) { %>
                        <button class="btn-review" onclick="showReviewModal()">Deixar uma Avaliação</button>
                    <% } else { %>
                        <p style="color: #888; margin-bottom: 20px;"><a href="/auth/login" style="color: #ffa500;">Faça login</a> para avaliar este profissional.</p>
                    <% } %>

                    <div id="reviewsList">
                        <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
                            <% reviews.filter(r => r.status === 'visible').forEach(review => { %>
                                <div class="review-item">
                                    <div class="review-header">
                                        <span class="review-user">Cliente Verificado</span>
                                        <span class="review-rating">
                                            <% for(let i=0; i<5; i++) { %>
                                                <i class="fas fa-star" style="color: <%= i < review.rating ? '#ffa500' : '#444' %>"></i>
                                            <% } %>
                                        </span>
                                    </div>
                                    <p class="review-comment"><%= review.comment %></p>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p style="color: #666;">Nenhuma avaliação ainda. Seja o primeiro a avaliar!</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="booking-sidebar">
                <div class="booking-card">
                    <div class="price-info">
                        Atendimento em <span><%= profissional.city %></span>
                    </div>
                    <button onclick="handleWhatsAppClick()" class="btn-contact" id="profileContactBtn" data-professional-id="<%= profissional.user_id %>" data-profession="<%= profissional.profissao || profissional.categories?.name || 'Profissional' %>">
                        <i class="fab fa-whatsapp"></i> Contratar Agora
                    </button>
                    <p class="security-note">Converse pelo fluxo do Contrataê para manter histórico, segurança e controle da contratação.</p>
                </div>
            </div>
        </div>
    </main>

    <!-- Modal de Segurança WhatsApp -->
    <div id="whatsappModal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="hideModal('whatsappModal')">&times;</span>
            <h2 id="contactModalTitle">Dica de Segurança</h2>
            <p id="contactModalText">Para sua segurança, mantenha a conversa até o término do serviço. Evite pagamentos antecipados sem garantias.</p>
            <p id="contactModalExtra" style="font-size:13px;color:#9aa4b2"></p>
            <div class="modal-footer" id="contactModalActions">
                <a id="whatsappLink" href="#" class="btn-modal btn-modal-primary" style="text-align: center; text-decoration: none;" target="_blank" onclick="hideModal('whatsappModal')">Entendi, ir para o WhatsApp</a>
            </div>
        </div>
    </div>

    <div class="profile-lightbox" id="profileLightbox">
        <button class="lightbox-btn lightbox-close" type="button" onclick="closeProfileLightbox()">&times;</button>
        <button class="lightbox-btn lightbox-prev" type="button" onclick="moveProfileLightbox(-1)"><i class="fas fa-chevron-left"></i></button>
        <img id="profileLightboxImg" src="" alt="Imagem ampliada">
        <button class="lightbox-btn lightbox-next" type="button" onclick="moveProfileLightbox(1)"><i class="fas fa-chevron-right"></i></button>
        <div class="lightbox-count" id="profileLightboxCount"></div>
    </div>

    <!-- Modal de Avaliação -->
    <div id="reviewModal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="hideModal('reviewModal')">&times;</span>
            <h2>Avaliar Profissional</h2>
            <p style="font-size: 13px; color: #ff4444;">"Avaliações devem ser feitas com responsabilidade. Comentários ofensivos podem resultar em banimento da conta."</p>
            
            <form id="reviewForm">
                <input type="hidden" name="professional_id" value="<%= profissional.user_id %>">
                <div class="form-group">
                    <label>Sua Nota</label>
                    <select name="rating" required>
                        <option value="5">5 Estrelas - Excelente</option>
                        <option value="4">4 Estrelas - Muito Bom</option>
                        <option value="3">3 Estrelas - Bom</option>
                        <option value="2">2 Estrelas - Regular</option>
                        <option value="1">1 Estrela - Ruim</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Seu Comentário</label>
                    <textarea name="comment" rows="4" placeholder="Conte como foi sua experiência..." required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modal btn-modal-secondary" onclick="hideModal('reviewModal')">Cancelar</button>
                    <button type="submit" class="btn-modal btn-modal-primary">Enviar Avaliação</button>
                </div>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/mobile-bottom-nav', { active: 'perfil' }) %>

    <script>
        function showReviewModal() {
            document.getElementById('reviewModal').style.display = 'flex';
        }

        const galleryImages = <%- JSON.stringify(galleryImages) %>;
        let currentLightboxIndex = 0;

        function openProfileLightbox(index) {
            currentLightboxIndex = Number(index || 0);
            const modal = document.getElementById('profileLightbox');
            syncProfileLightbox();
            modal?.classList.add('active');
        }
        function syncProfileLightbox() {
            const img = document.getElementById('profileLightboxImg');
            const count = document.getElementById('profileLightboxCount');
            if (!img || !galleryImages.length) return;
            if (currentLightboxIndex < 0) currentLightboxIndex = galleryImages.length - 1;
            if (currentLightboxIndex >= galleryImages.length) currentLightboxIndex = 0;
            img.src = galleryImages[currentLightboxIndex];
            if (count) count.textContent = `${currentLightboxIndex + 1} de ${galleryImages.length}`;
        }
        function moveProfileLightbox(direction) { currentLightboxIndex += direction; syncProfileLightbox(); }
        function closeProfileLightbox() { document.getElementById('profileLightbox')?.classList.remove('active'); }
        document.querySelectorAll('[data-gallery-index]').forEach(img => img.addEventListener('click', () => openProfileLightbox(img.dataset.galleryIndex)));

        function setContactModal(title, text, extra, mode, data) {
            document.getElementById('contactModalTitle').textContent = title;
            document.getElementById('contactModalText').textContent = text;
            document.getElementById('contactModalExtra').textContent = extra || '';
            const actions = document.getElementById('contactModalActions');
            if (mode === 'login') {
                actions.innerHTML = `<a class="btn-modal btn-modal-secondary" style="text-align:center;text-decoration:none" href="${data.login_url || '/auth/login'}">Entrar</a><a class="btn-modal btn-modal-primary" style="text-align:center;text-decoration:none" href="${data.cadastro_url || '/auth/cadastro-form?type=client'}">Criar conta cliente</a>`;
            } else if (mode === 'whatsapp') {
                actions.innerHTML = `<a id="whatsappLink" href="${data.whatsapp_url || '#'}" class="btn-modal btn-modal-primary" style="text-align:center;text-decoration:none" target="_blank" onclick="hideModal('whatsappModal')">Entendi, ir para o WhatsApp</a>`;
            } else {
                actions.innerHTML = `<button type="button" class="btn-modal btn-modal-primary" onclick="hideModal('whatsappModal')">Entendi</button>`;
            }
            document.getElementById('whatsappModal').style.display = 'flex';
        }

        async function handleWhatsAppClick() {
            const button = document.getElementById('profileContactBtn');
            const original = button?.innerHTML;
            if (button) { button.disabled = true; button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verificando...'; }
            try {
                const response = await fetch('/api/contact-leads', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        professional_id: button?.dataset.professionalId || '<%= profissional.user_id %>',
                        profession: button?.dataset.profession || 'Profissional',
                        source_url: window.location.pathname + window.location.search
                    })
                });
                const data = await response.json().catch(() => ({}));
                if (response.status === 401 || data.login_required) {
                    setContactModal('Entre para contratar com segurança', 'Para chamar este profissional, entre ou crie uma conta de cliente. Assim o Contrataê registra o histórico do atendimento e aumenta a confiabilidade para os dois lados.', '', 'login', data);
                    return;
                }
                if (!response.ok || !data.ok || !data.whatsapp_url) {
                    setContactModal('Contato indisponível', data.message || 'Não foi possível liberar o contato agora.', '', 'info', {});
                    return;
                }
                setContactModal('Dica de Segurança', 'Para sua segurança, mantenha a conversa registrada até o término do serviço. Evite pagamentos antecipados sem garantias.', 'O profissional também será notificado dentro da plataforma.', 'whatsapp', data);
            } catch (err) {
                setContactModal('Erro de conexão', 'Não foi possível liberar o contato agora.', '', 'info', {});
            } finally {
                if (button) { button.disabled = false; button.innerHTML = original; }
            }
        }

        function hideModal(id) {
            document.getElementById(id).style.display = 'none';
        }

        document.getElementById('reviewForm').onsubmit = async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/api/reviews', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                
                if (result.sucesso) {
                    alert(result.mensagem);
                    location.reload();
                } else {
                    alert(result.erro || 'Erro ao enviar avaliação.');
                }
            } catch (err) {
                alert('Erro de conexão.');
            }
        };

        // Fechar modais ao clicar fora
        window.onclick = function(event) {
            if (event.target.className === 'modal') {
                event.target.style.display = 'none';
            }
            if (event.target.id === 'profileLightbox') {
                closeProfileLightbox();
            }
        }
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') closeProfileLightbox();
            if (event.key === 'ArrowLeft') moveProfileLightbox(-1);
            if (event.key === 'ArrowRight') moveProfileLightbox(1);
        });
    </script>
</body>
</html>
