<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" type="image/png" href="/imagens/app/favicon.png">
    <link rel="apple-touch-icon" href="/imagens/app/apple-touch-icon.png">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Contrataê">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#101114">
    <meta property="og:site_name" content="Contrataê">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Contrataê · Profissionais locais">
    <meta property="og:description" content="Encontre profissionais locais, veja portfólios e entre em contato com facilidade.">
    <meta property="og:image" content="https://contrataeapp.onrender.com/imagens/app/contratae-social.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://contrataeapp.onrender.com/imagens/app/contratae-social.png">
    <title>Contrataê - Página Não Encontrada</title>
    <link rel="stylesheet" href="/css/style_laranja_preto.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body class="dark-mode">
    <%- include('partials/header') %>
    <%- include('partials/top-status-bar') %>

    <main style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20px;">
        <div class="container">
            <img src="/imagens/equipe_site/Mascote.png" alt="Mascote Contrataê" style="width: 220px; height: auto; border-radius: 20px; margin-bottom: 20px; object-fit: cover; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
            <h1 style="font-size: 3rem; margin-bottom: 10px;">404</h1>
            <h2 style="margin-bottom: 20px;"><%= typeof mensagem !== 'undefined' ? mensagem : 'Página não encontrada' %></h2>
            <p style="color: #ccc; margin-bottom: 30px;">Desculpe, a página que você está procurando não existe ou foi movida.</p>
            <a href="/" class="button primary-button" style="padding: 15px 40px; border-radius: 30px;">Voltar para o Início</a>
        </div>
    </main>

    <%- include('partials/mobile-bottom-nav', { active: 'menu' }) %>
    <%- include('partials/footer') %>
    
</body>
</html>
