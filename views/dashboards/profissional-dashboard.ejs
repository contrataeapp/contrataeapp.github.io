function maskPhone(value){
  const digits=String(value||'').replace(/\D/g,'').slice(0,11);
  if(digits.length<=2) return digits ? `(${digits}` : '';
  if(digits.length<=6) return `(${digits.slice(0,2)}) ${digits.slice(2)}`;
  if(digits.length<=10) return `(${digits.slice(0,2)}) ${digits.slice(2,6)}-${digits.slice(6)}`;
  return `(${digits.slice(0,2)}) ${digits.slice(2,7)}-${digits.slice(7)}`;
}
function maskCep(value){ const d=String(value||'').replace(/\D/g,'').slice(0,8); return d.length>5?`${d.slice(0,5)}-${d.slice(5)}`:d; }
document.querySelectorAll('[data-mask="phone"]').forEach(field=>{ field.value=maskPhone(field.value); field.addEventListener('input',()=>field.value=maskPhone(field.value)); });
document.querySelectorAll('[data-mask="cep"]').forEach(field=>{ field.value=maskCep(field.value); field.addEventListener('input',()=>field.value=maskCep(field.value)); });
document.querySelectorAll('input[name="service_fee_amount"]').forEach(field=>field.addEventListener('input',()=>field.value=field.value.replace(/[^\d,]/g,'')));
async function lookupProfileCep(){
  const cepField=document.getElementById('profileCepInput'); const status=document.getElementById('profileCepStatus'); const cep=String(cepField?.value||'').replace(/\D/g,'');
  if(cep.length!==8){ if(status) status.textContent='Informe um CEP com 8 números.'; return; }
  if(status) status.innerHTML='<i class="fas fa-spinner fa-spin"></i> Buscando CEP...';
  try{
    const response=await fetch(`/api/cep/${cep}`); const data=await response.json(); if(!response.ok) throw new Error(data.error||'CEP não encontrado');
    const set=(id,value)=>{const el=document.getElementById(id); if(el && value) el.value=value;};
    set('profileCityInput',data.city); set('profileStateInput',data.state); set('profileStreetInput',data.street); set('profileNeighborhoodInput',data.neighborhood); set('profileComplementInput',data.complement);
    if(cepField) cepField.value=maskCep(data.cep||cep); if(status) status.innerHTML='<i class="fas fa-circle-check" style="color:#73d38a"></i> CEP encontrado. Confira os dados antes de salvar.';
  }catch(err){ if(status) status.textContent=err.message||'Não foi possível consultar o CEP agora.'; }
}
document.getElementById('lookupProfileCep')?.addEventListener('click',lookupProfileCep);
document.getElementById('profileCepInput')?.addEventListener('blur',function(){ if(String(this.value||'').replace(/\D/g,'').length===8) lookupProfileCep(); });
async function lookupCepByAddress(){
  const state=String(document.getElementById('profileStateInput')?.value||'').trim().toUpperCase();
  const city=String(document.getElementById('profileCityInput')?.value||'').trim();
  const street=String(document.getElementById('profileStreetInput')?.value||'').trim();
  const status=document.getElementById('profileCepStatus'); const modal=document.getElementById('cepAddressModal'); const results=document.getElementById('cepAddressResults');
  if(state.length!==2 || city.length<3 || street.length<3){ if(status) status.textContent='Para procurar o CEP pelo endereço, informe Estado, Cidade e Rua/Avenida.'; return; }
  if(results) results.innerHTML='<div class="small"><i class="fas fa-spinner fa-spin"></i> Procurando endereços...</div>'; modal?.classList.add('active');
  try{
    const response=await fetch(`/api/cep/buscar?state=${encodeURIComponent(state)}&city=${encodeURIComponent(city)}&street=${encodeURIComponent(street)}`); const data=await response.json();
    if(!response.ok) throw new Error(data.error||'Não foi possível procurar o CEP');
    const matches=Array.isArray(data.matches)?data.matches:[];
    if(!matches.length){ if(results) results.innerHTML='<div class="small">Nenhum CEP correspondente foi encontrado. Você pode fechar esta janela e salvar o endereço sem CEP; o Maps usará rua, número, cidade e estado. Informar o CEP, quando disponível, melhora a precisão.<br><br><a href="https://www.correios.com.br/atendimento/ferramentas/sistemas" target="_blank" rel="noopener" style="color:#ffb020;font-weight:800">Consultar o Busca CEP dos Correios</a></div>'; return; }
    if(results) results.innerHTML='';
    matches.forEach(match=>{
      const btn=document.createElement('button'); btn.type='button'; btn.className='btn btn-secondary'; btn.style.cssText='justify-content:flex-start;text-align:left;white-space:normal;min-height:48px';
      const icon=document.createElement('i'); icon.className='fas fa-location-dot';
      const copy=document.createElement('span'); const title=document.createElement('strong'); title.textContent=match.street||street; const br=document.createElement('br'); const meta=document.createElement('small'); meta.textContent=`${match.neighborhood?match.neighborhood+' · ':''}${match.city||city}/${match.state||state} · CEP ${match.cep||''}`; copy.append(title,br,meta); btn.append(icon,copy);
      btn.addEventListener('click',()=>{ const set=(id,value)=>{const el=document.getElementById(id); if(el && value) el.value=value;}; set('profileCepInput',maskCep(match.cep)); set('profileCityInput',match.city); set('profileStateInput',match.state); set('profileStreetInput',match.street); set('profileNeighborhoodInput',match.neighborhood); if(status) status.innerHTML='<i class="fas fa-circle-check" style="color:#73d38a"></i> CEP escolhido pelo endereço. Confira os dados antes de salvar.'; modal?.classList.remove('active'); });
      results?.appendChild(btn);
    });
  }catch(err){ if(results) results.innerHTML=`<div class="small">${err.message||'Não foi possível procurar o CEP agora.'}<br>Você ainda pode salvar o endereço sem CEP.</div>`; }
}
document.getElementById('lookupCepByAddress')?.addEventListener('click',lookupCepByAddress);
