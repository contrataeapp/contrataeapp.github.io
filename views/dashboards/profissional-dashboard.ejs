                button.classList.add('is-loading'); button.disabled = true;
                button.innerHTML = button.classList.contains('preview-profession-btn') ? '<i class="fas fa-spinner fa-spin"></i> Preparando prévia...' : '<i class="fas fa-spinner fa-spin"></i> Salvando...';
            }
        });
    });

let lastLeadIds = new Set();
let soundUnlocked = false;
document.addEventListener('click', () => { soundUnlocked = true; }, { once:true });
function safePlayLeadSound(kind='new'){
  if(!soundUnlocked) return;
  const audio = document.getElementById(kind === 'alert' ? 'leadAlertSound' : 'leadSound');
  if(audio){ audio.currentTime = 0; audio.play().catch(()=>{}); }
}
function escapeHtml(value){ return String(value || '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch])); }
function leadCardHtml(lead){
  const date = lead.contacted_at ? new Date(lead.contacted_at).toLocaleString('pt-BR') : '';
  const category = escapeHtml(lead.professional_category || 'Serviço');
  const name = escapeHtml(lead.client_name || 'Cliente Contrataê');
  const email = lead.client_email ? ` · ${escapeHtml(lead.client_email)}` : '';
  const message = escapeHtml(lead.message || 'Cliente abriu contato pelo perfil público.');
  return `<div class="lead-card new" data-lead-id="${lead.id}">
    <div><strong>${category}</strong> solicitado por <strong>${name}</strong>${email}</div>
    <div class="small">${date}</div>
    <div class="small">${message}</div>
    <div class="lead-actions">
      <button class="btn btn-primary" type="button" onclick="updateLeadStatus('${lead.id}','accepted')"><i class="fas fa-check"></i> Aceitei o serviço</button>
      <button class="btn btn-secondary" type="button" onclick="updateLeadStatus('${lead.id}','declined')"><i class="fas fa-times"></i> Não fechei</button>
      <button class="btn btn-secondary" type="button" onclick="updateLeadStatus('${lead.id}','archived')">Arquivar</button>
    </div>
  </div>`;
}
async function loadPendingLeads(){
  const panel = document.getElementById('pendingLeadsPanel');
  const list = document.getElementById('pendingLeadsList');
  const servicesList = document.getElementById('servicesLeadsList');
  try{
    const res = await fetch('/api/profissional/contatos-pendentes');
    const data = await res.json();
    if(!data.ok && data.setup_required){
      const msg = '<p class="small">Histórico de contatos ainda não ativado. Rode o SQL 06_contact_leads.sql para ligar esta área.</p>';
      if(servicesList) servicesList.innerHTML = msg;
      return;
    }
    const leads = data.leads || [];
    const currentIds = new Set(leads.map(l=>l.id));
    const hasNew = leads.some(l=>!lastLeadIds.has(l.id));
    if(leads.length){
      const html = leads.map(leadCardHtml).join('');
      if(panel) panel.style.display = '';
      if(list) list.innerHTML = html;
      if(servicesList) servicesList.innerHTML = html;
      if(hasNew && lastLeadIds.size){
        document.getElementById('leadFloatingAlert')?.classList.add('active');
        safePlayLeadSound('new');
      }
    } else {
      if(panel) panel.style.display = 'none';
      if(list) list.innerHTML = '';
      if(servicesList) servicesList.innerHTML = '<p class="small">Nenhum serviço pendente agora.</p>';
    }
    lastLeadIds = currentIds;
  } catch(err){
    if(servicesList) servicesList.innerHTML = '<p class="small">Não foi possível carregar os serviços pendentes agora.</p>';
  }
}
window.updateLeadStatus = async function(id, status){
  try{
    await fetch(`/api/profissional/contatos/${id}/status`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({status}) });
    safePlayLeadSound('alert');
    await loadPendingLeads();
  } catch(err){ alert('Não foi possível atualizar este contato.'); }
};
loadPendingLeads();
setInterval(loadPendingLeads, 60000);
    
