<div class="modal-overlay-local" id="approvalSentModal">
  <div class="modal-card-local">
    <h3>Perfil enviado</h3>
    <p>Seu pedido foi enviado com sucesso. Agora é só aguardar a resposta da administração.</p>
    <div class="modal-actions-local">
      <button type="button" class="btn btn-primary" id="closeApprovalSentModal">Entendi</button>
    </div>
  </div>
</div>
<script>
const activeTab = '<%= activeTab || "resumo" %>';
const currentProfessionalId = '<%= profissional.user_id || profissional.id || "professional" %>';

// v11.3.38: tema da Área Profissional usa o mesmo botão sol/lua e a mesma preferência `theme` do restante da plataforma.
const PROFESSIONAL_THEME_KEY='theme';
function updateProfessionalThemeIcon(isLight){
    const btn=document.getElementById('theme-toggle');
    const icon=btn?.querySelector('i');
    if(icon){ icon.classList.toggle('fa-sun',isLight); icon.classList.toggle('fa-moon',!isLight); }
    if(btn){ btn.setAttribute('aria-pressed',isLight?'true':'false'); btn.title=isLight?'Usar modo escuro':'Usar modo claro'; }
}
function applyProfessionalTheme(choice='dark'){
    const isLight=choice==='light';
    document.body.classList.toggle('light-mode',isLight);
    updateProfessionalThemeIcon(isLight);
    const meta=document.querySelector('meta[name="theme-color"]'); if(meta) meta.setAttribute('content',isLight?'#f3f5f8':'#101114');
    try{ localStorage.setItem(PROFESSIONAL_THEME_KEY,isLight?'light':'dark'); }catch(_){}
}
let initialProfessionalTheme='dark'; try{ initialProfessionalTheme=localStorage.getItem(PROFESSIONAL_THEME_KEY)==='light'?'light':'dark'; }catch(_){}
applyProfessionalTheme(initialProfessionalTheme);
document.getElementById('theme-toggle')?.addEventListener('click',()=>applyProfessionalTheme(document.body.classList.contains('light-mode')?'dark':'light'));

let deferredInstallPrompt=null;
window.addEventListener('beforeinstallprompt',event=>{ event.preventDefault(); deferredInstallPrompt=event; const btn=document.getElementById('installContrataeBtn'); if(btn) btn.hidden=false; });
window.addEventListener('appinstalled',()=>{ deferredInstallPrompt=null; const btn=document.getElementById('installContrataeBtn'); if(btn) btn.hidden=true; });
document.addEventListener('click',async e=>{ const btn=e.target?.closest?.('#installContrataeBtn'); if(!btn||!deferredInstallPrompt) return; btn.disabled=true; try{ await deferredInstallPrompt.prompt(); await deferredInstallPrompt.userChoice; }catch(_){} finally{ deferredInstallPrompt=null; btn.hidden=true; btn.disabled=false; } });
const mobileDashboardSections = {
    resumo:{label:'Visão Geral',icon:'fa-chart-line'}, servicos:{label:'Meus Serviços',icon:'fa-briefcase'}, avaliacoes:{label:'Avaliações',icon:'fa-star'}, perfil:{label:'Meu Perfil',icon:'fa-user'}, profissoes:{label:'Minhas Profissões',icon:'fa-layer-group'}, portfolio:{label:'Meu Portfólio',icon:'fa-images'}, planos:{label:'Meu Plano',icon:'fa-credit-card'}, pagamentos:{label:'Pagamentos',icon:'fa-money-check'}
};
function syncMobileDashboardNavigation(tab){
    const meta=mobileDashboardSections[tab] || mobileDashboardSections.resumo;
    const icon=document.getElementById('mobileSectionIcon'); if(icon) icon.innerHTML=`<i class="fas ${meta.icon}"></i>`;
    const label=document.getElementById('mobileSectionLabel'); if(label) label.textContent=meta.label;
    document.querySelectorAll('[data-mobile-tab]').forEach(btn=>btn.classList.toggle('active',btn.dataset.mobileTab===tab));
    const more=document.querySelector('[data-mobile-more]'); if(more) more.classList.toggle('active',!['resumo','servicos','profissoes','portfolio'].includes(tab));
}
function closeMobileMore(){ const overlay=document.getElementById('mobileMoreOverlay'); overlay?.classList.remove('active'); overlay?.setAttribute('aria-hidden','true'); document.body.style.overflow=''; }
function openTab(tab, options = {}){
    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.nav-link[data-tab]').forEach(el => el.classList.remove('active'));
    const panel = document.getElementById(tab); if(panel) panel.classList.add('active');
    const link = document.querySelector(`.nav-link[data-tab="${tab}"]`); if(link) link.classList.add('active');
    syncMobileDashboardNavigation(tab);
    if(options.mobileScroll && window.matchMedia('(max-width:820px)').matches){ window.scrollTo({top:0,behavior:'smooth'}); }
    const url = new URL('/profissional/dashboard', window.location.origin);
    url.searchParams.set('tab', tab);
    if(options.slot){
        url.searchParams.set('slot', String(options.slot));
    } else if(options.preserveSlot){
        const current = new URLSearchParams(window.location.search);
        const slot = current.get('slot');
        if(slot) url.searchParams.set('slot', slot);
    }
    history.replaceState({}, '', url.pathname + url.search);
}
document.addEventListener('DOMContentLoaded', ()=>{
    const initialParams = new URLSearchParams(window.location.search);
    const selectedSlotParam = initialParams.get('slot');
    if(selectedSlotParam){ setTimeout(()=>{ const pane=document.getElementById(`profession-pane-${selectedSlotParam}`); pane?.classList.add('profession-focus-pulse'); setTimeout(()=>pane?.classList.remove('profession-focus-pulse'),1800); },120); }
    document.querySelectorAll('.nav-link[data-tab]').forEach(link => link.addEventListener('click', ev => { ev.preventDefault(); openTab(link.dataset.tab); }));
    document.querySelectorAll('[data-mobile-tab]').forEach(btn=>btn.addEventListener('click',()=>openTab(btn.dataset.mobileTab,{mobileScroll:true})));
    const moreOverlay=document.getElementById('mobileMoreOverlay');
    document.querySelector('[data-mobile-more]')?.addEventListener('click',()=>{ moreOverlay?.classList.add('active'); moreOverlay?.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; });
    document.getElementById('mobileMoreClose')?.addEventListener('click',closeMobileMore);
    moreOverlay?.addEventListener('click',e=>{ if(e.target===moreOverlay) closeMobileMore(); });
    document.querySelectorAll('[data-mobile-sheet-tab]').forEach(btn=>btn.addEventListener('click',()=>{ closeMobileMore(); openTab(btn.dataset.mobileSheetTab,{mobileScroll:true}); }));

    const approvedBanner=document.getElementById('approvedProfileBanner');
    const approvedBannerToggle=document.getElementById('approvedBannerToggle');
    const APPROVED_BANNER_KEY='contratae-approved-banner-collapsed';
    function setApprovedBannerCollapsed(collapsed){
        approvedBanner?.classList.toggle('is-collapsed',collapsed);
        approvedBannerToggle?.setAttribute('aria-expanded',collapsed?'false':'true');
        if(approvedBannerToggle) approvedBannerToggle.title=collapsed?'Expandir aviso':'Recolher aviso';
        try{ localStorage.setItem(APPROVED_BANNER_KEY,collapsed?'1':'0'); }catch(_){}
    }
    if(approvedBanner){ let collapsed=false; try{collapsed=localStorage.getItem(APPROVED_BANNER_KEY)==='1'}catch(_){} setApprovedBannerCollapsed(collapsed); }
    approvedBannerToggle?.addEventListener('click',()=>setApprovedBannerCollapsed(!approvedBanner?.classList.contains('is-collapsed')));

    document.querySelectorAll('[data-dashboard-shortcut]').forEach(btn=>btn.addEventListener('click',()=>openTab(btn.dataset.dashboardShortcut,{mobileScroll:true})));

    openTab(activeTab || 'resumo', { preserveSlot: true });

    const profilePhotoInput = document.getElementById('profilePhotoInput');
    window.openProfilePhotoPicker = function(){
        const input = document.getElementById('profilePhotoInput');
        if(input){ input.click(); return; }
        openTab('perfil');
        setTimeout(()=>document.getElementById('profilePhotoInput')?.click(), 150);
    };
    window.toggleQuickGuide = function(){
        document.getElementById('quickGuideProfessions')?.classList.toggle('active');
    };
    profilePhotoInput?.addEventListener('change', function(){
        if(this.files && this.files.length){
            const preview=document.querySelector('.profile-photo-preview'); const topAvatar=document.querySelector('.avatar-action'); const copy=document.querySelector('.profile-photo-copy');
            preview?.classList.add('avatar-uploading'); topAvatar?.classList.add('avatar-uploading');
            const status=document.createElement('div'); status.className='avatar-upload-status'; status.innerHTML='<i class="fas fa-spinner fa-spin"></i> Enviando foto...'; copy?.appendChild(status);
            const globalStatus=document.createElement('div'); globalStatus.className='avatar-global-status'; globalStatus.innerHTML='<i class="fas fa-spinner fa-spin"></i> Enviando nova foto de perfil...'; document.body.appendChild(globalStatus);
            document.getElementById('profilePhotoForm')?.requestSubmit();
        }
    });

    const professionEditorSelect = document.getElementById('professionEditorSelect');
    function syncProfessionEditor(){
        const selected = professionEditorSelect?.value;
        document.querySelectorAll('.profession-editor-pane').forEach(pane => pane.classList.add('hidden-pane'));
        if(selected){
            document.getElementById(selected)?.classList.remove('hidden-pane');
        }
    }
    professionEditorSelect?.addEventListener('change', ()=>{
        syncProfessionEditor();
        const slot=String(professionEditorSelect.value||'').replace('profession-pane-','');
        if(slot && document.getElementById('profissoes')?.classList.contains('active')){ const url=new URL(window.location.href); url.searchParams.set('tab','profissoes'); url.searchParams.set('slot',slot); history.replaceState({},'',url.pathname+url.search); }
    });
    syncProfessionEditor();
    document.querySelectorAll('[data-profession-shortcut-slot]').forEach(btn=>btn.addEventListener('click',()=>{
        const slot=String(btn.dataset.professionShortcutSlot||'');
        const option=professionEditorSelect?Array.from(professionEditorSelect.options).find(o=>o.value===`profession-pane-${slot}`):null;
        if(option){ professionEditorSelect.value=option.value; syncProfessionEditor(); }
        openTab('profissoes',{slot,mobileScroll:true});
        setTimeout(()=>document.getElementById(`profession-pane-${slot}`)?.scrollIntoView({behavior:'smooth',block:'start'}),100);
    }));
    if ((activeTab || '') === 'profissoes' && selectedSlotParam) {
        setTimeout(() => document.getElementById(`profession-pane-${selectedSlotParam}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 180);
    }

    const portfolioProfessionSelect = document.getElementById('portfolioProfessionSelect');
    function syncPortfolioPane(){
        const target = portfolioProfessionSelect?.value;
        document.querySelectorAll('.portfolio-profession-pane').forEach(pane => pane.classList.add('hidden-pane'));
        if(target) document.getElementById(target)?.classList.remove('hidden-pane');
        const slot = portfolioProfessionSelect?.selectedOptions?.[0]?.dataset?.slot;
        if(slot && document.getElementById('portfolio')?.classList.contains('active')){
            const url = new URL(window.location.href); url.searchParams.set('tab','portfolio'); url.searchParams.set('slot',slot); history.replaceState({},'',url.pathname+url.search);
        }
    }
    portfolioProfessionSelect?.addEventListener('change', ()=>{
        syncPortfolioPane();
        const slot=portfolioProfessionSelect?.selectedOptions?.[0]?.dataset?.slot;
        const context=document.querySelector(`[data-portfolio-context-confirm="${slot}"]`);
        context?.classList.remove('active'); void context?.offsetWidth; context?.classList.add('active');
        setTimeout(()=>context?.classList.remove('active'),2600);
    });
    syncPortfolioPane();
    if ((activeTab || '') === 'portfolio') {
        const slot=portfolioProfessionSelect?.selectedOptions?.[0]?.dataset?.slot;
        const context=document.querySelector(`[data-portfolio-context-confirm="${slot}"]`);
        portfolioProfessionSelect?.classList.add('portfolio-selector-attention'); context?.classList.add('active');
        setTimeout(()=>{portfolioProfessionSelect?.classList.remove('portfolio-selector-attention');context?.classList.remove('active');},3600);
    }

    document.querySelectorAll('.choose-portfolio-image,.portfolio-empty-trigger').forEach(btn => {
        btn.addEventListener('click', () => document.getElementById(btn.dataset.input)?.click());
    });
    document.querySelectorAll('.profession-file-input').forEach(input => {
        input.addEventListener('change', () => {
            const form = input.closest('.profession-upload-form');
            const file = input.files && input.files[0];
            const name = form?.querySelector('.profession-file-name');
            const preview = form?.querySelector('.profession-preview');
            const img = preview?.querySelector('img');
            const choose = form?.querySelector('.choose-portfolio-image');
            if(!file){ if(name) name.textContent='Nenhuma imagem selecionada.'; preview?.classList.remove('active'); return; }
            if(name) name.textContent = file.name;
            if(img){ img.src = URL.createObjectURL(file); preview?.classList.add('active'); }
            form?.classList.add('uploading');
            if(choose){ choose.disabled=true; choose.innerHTML='<i class="fas fa-spinner fa-spin"></i> Enviando...'; }
            // Garante que qualquer texto ainda em edição esteja protegido antes do reload do upload.
            document.querySelectorAll('.profession-update-form').forEach(draftForm=>saveProfessionDraft(draftForm,{immediate:true}));
            setTimeout(()=>{
                const submitter=form?.querySelector('.auto-portfolio-submit');
                if(form && submitter) form.requestSubmit(submitter);
                else form?.requestSubmit();
            },120);
        });
    });

    function timeValues(){ const values=[]; for(let h=0;h<24;h++){ for(let m=0;m<60;m+=30){ values.push(`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`); }} return values; }
    function fillTimeSelect(select, selected=''){
        if(!select) return; const options=['<option value="">Selecione</option>'].concat(timeValues().map(v=>`<option value="${v}" ${v===selected?'selected':''}>${v}</option>`)); select.innerHTML=options.join('');
    }
    function syncEndOptions(startSelect,endSelect){
        if(!startSelect||!endSelect) return; const start=startSelect.value; const current=endSelect.value; const values=timeValues().filter(v=>!start||v>start);
        endSelect.innerHTML=['<option value="">Selecione</option>'].concat(values.map(v=>`<option value="${v}">${v}</option>`)).join('');
