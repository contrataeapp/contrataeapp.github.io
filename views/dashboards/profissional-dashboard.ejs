kground:rgba(255,255,255,.98);border-color:#d8dde5}.light-mode .mobile-dashboard-bottom-nav button{color:#657182}.light-mode .mobile-more-sheet{background:#fff;border-color:#d8dde5}.light-mode .mobile-more-sheet-head strong{color:#171a20}.light-mode .mobile-more-grid button,.light-mode .mobile-more-grid a{background:#f8fafc;color:#222a35;border-color:#d8dde5}.light-mode .dashboard-theme-toggle{color:#333b46}.light-mode .dashboard-theme-toggle:hover{color:#9b6100;background:#fff4df}.light-mode .flash.success{background:#edf9f0;color:#285d35}.light-mode .flash.error{background:#fff0f0;color:#8a2f2f}.light-mode .flash.info{background:#eef4ff;color:#244578}.light-mode .modal-card-local{background:#fff;color:#1d222b;border-color:#d8dde5}.light-mode .modal-card-local p{color:#5a6573}.light-mode .table-wrap table{color:#1d222b}.light-mode th,.light-mode td{border-color:#e1e6ec}.light-mode .lead-card{background:#fff;border-color:#dce2e8;color:#1d222b}.light-mode .mobile-profession-context{background:rgba(255,248,232,.98);color:#503b14}.light-mode .review-overview-card,.light-mode .professional-review-card,.light-mode .professional-review-empty{background:#f8fafc;border-color:#dce2e8;color:#1d222b}.light-mode .professional-review-card p{color:#303846}.light-mode .plan-current-banner{background:#edf9f0;border-color:#bde3c7}.light-mode .plan-current-banner strong{color:#285d35}.light-mode .plan-current-banner span{color:#4f6555}

        .light-mode .approved-banner h3{color:#236b38}.light-mode .approved-banner p{color:#375440}.light-mode .approved-collapse-toggle{color:#236b38;border-color:#b7ddc1;background:#f8fff9}.light-mode .summary-shortcut{background:#fff;color:#1d222b;border-color:#d9e0e8}.light-mode .summary-shortcut:hover{background:#fff8ea;border-color:#d8b66f}.light-mode .summary-shortcut strong{color:#202731}.light-mode .summary-shortcut span{color:#556272}.light-mode .summary-shortcut .shortcut-arrow{color:#697586}.light-mode .performance-profession-card{color:#26313e}.light-mode .performance-profession-card .performance-return{color:#526071}.light-mode .performance-profession-card:hover{background:#fff8ea;border-color:#d8b66f}.light-mode .help,.light-mode .profile-photo-copy p,.light-mode .portfolio-info-note{color:#526071}.light-mode .field label{color:#3b4655}.light-mode .review-overview-card span{color:#596575}.light-mode .professional-review-empty{color:#596575}.light-mode .profession-help{color:#59461f;background:#fff8ea;border-color:#e8d1a0}.light-mode .portfolio-info-note{background:#fff8ea;border-color:#e8d1a0}.light-mode .availability-summary-preview{color:#374353;background:#fff8ea}.light-mode .plan-current-banner span{color:#405c49}

    </style>
</head>
<body class="professional-dashboard-body">
<div class="dashboard-container">
    <aside class="sidebar">
        <div class="logo"><a href="/">Contrataê</a></div>
        <ul>
            <li><a href="/" class="nav-link"><i class="fas fa-home"></i> Início</a></li>
            <li><a href="#" class="nav-link" data-tab="resumo"><i class="fas fa-chart-line"></i> Visão Geral</a></li>
            <li><a href="#" class="nav-link" data-tab="servicos"><i class="fas fa-briefcase"></i> Meus Serviços</a></li>
            <li><a href="#" class="nav-link" data-tab="avaliacoes"><i class="fas fa-star"></i> Avaliações</a></li>
            <li><a href="#" class="nav-link" data-tab="perfil"><i class="fas fa-user"></i> Meu Perfil</a></li>
            <li><a href="#" class="nav-link" data-tab="profissoes"><i class="fas fa-layer-group"></i> Minhas Profissões</a></li>
            <li><a href="#" class="nav-link" data-tab="portfolio"><i class="fas fa-image"></i> Meu Portfólio</a></li>
            <li><a href="#" class="nav-link" data-tab="planos"><i class="fas fa-credit-card"></i> Meu Plano</a></li>
            <li><a href="#" class="nav-link" data-tab="pagamentos"><i class="fas fa-money-check"></i> Pagamentos</a></li>
            <li><form method="POST" action="/auth/logout" class="sidebar-logout-form"><button type="submit" class="sidebar-logout-btn"><i class="fas fa-sign-out-alt"></i> Sair</button></form></li>
        </ul>
    </aside>

    <main class="main">
        <header>
            <div>
                <h1>Área do Profissional</h1>
                <div class="small">Gerencie seu perfil, portfólio e ativação da sua presença na plataforma.</div>
            </div>
            <div class="user-chip">
                <button type="button" id="theme-toggle" class="dashboard-theme-toggle" title="Alternar tema" aria-label="Alternar entre modo claro e escuro" aria-pressed="false"><i class="fas fa-moon"></i></button>
                <div class="user-chip-name"><%= fullName || 'Profissional' %></div>
                <button type="button" class="avatar avatar-action" onclick="openProfilePhotoPicker()" title="Clique para trocar sua foto de perfil">
                    <% if (profissional?.users?.avatar_url) { %><img src="<%= profissional.users.avatar_url %>" alt="Avatar"><% } else { %><%= (fullName || 'P').charAt(0).toUpperCase() %><% } %>
                </button>
            </div>
        </header>

        <div class="mobile-dashboard-topbar" aria-label="Seção atual da Área Profissional">
            <div class="mobile-section-icon" id="mobileSectionIcon"><i class="fas fa-chart-line"></i></div>
            <div class="mobile-section-copy">
                <small>Área do Profissional</small>
                <strong id="mobileSectionLabel">Visão Geral</strong>
            </div>
        </div>

        <% if (flashError && activeTab !== 'portfolio') { %><div class="flash error"><%= flashError %></div><% } %>
        <% if (flashSuccess && activeTab !== 'portfolio') { %><div class="flash success"><%= flashSuccess %></div><% } %>
        <% if (approvalPending) { %><div class="flash info">Seu perfil está em análise. Agora é só aguardar a resposta da administração.</div><% } %>

        <% if (!profileReadyForApproval) { %>
            <div class="banner">
                <h3>Seu perfil ainda não está pronto para aparecer no site</h3>
                <p>Finalize as etapas do cadastro para definir plano, profissões, descrição e imagens. Depois disso, você poderá revisar tudo com calma e só então solicitar aprovação.</p>
                <div class="top-actions">
                    <a href="/profissional/dashboard?tab=perfil" class="btn btn-primary">Editar perfil</a>
                    <form action="/auth/cancelar-profissional" method="POST"><button class="btn btn-secondary" type="submit">Cancelar cadastro</button></form>
                </div>
            </div>
        <% } else if (isApproved) { %>
            <div class="banner approved-banner" id="approvedProfileBanner">
                <div class="approved-banner-head">
                    <h3><i class="fas fa-circle-check"></i> Seu perfil está aprovado e publicado</h3>
                    <button type="button" class="approved-collapse-toggle" id="approvedBannerToggle" aria-expanded="true" aria-controls="approvedBannerBody" title="Recolher aviso"><i class="fas fa-chevron-down"></i></button>
                </div>
                <div class="approved-banner-body" id="approvedBannerBody">
                    <p>Agora você pode manter cada profissão atualizada sem refazer o cadastro. Ajuste os dados em “Minhas Profissões” e as fotos em “Meu Portfólio”.</p>
                    <div class="top-actions">
                        <button type="button" class="btn btn-primary" data-dashboard-shortcut="profissoes"><i class="fas fa-layer-group"></i> Minhas Profissões</button>
                        <button type="button" class="btn btn-secondary" data-dashboard-shortcut="portfolio"><i class="fas fa-images"></i> Meu Portfólio</button>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="banner">
                <h3>Seu perfil está pronto para a próxima etapa</h3>
                <p>Revise as informações abaixo. Quando estiver satisfeito, envie seu perfil para análise da plataforma.</p>
                <div class="top-actions">
                    <a href="/profissional/dashboard?tab=perfil" class="btn btn-secondary">Editar perfil</a>
                    <% if (approvalPending) { %>
                        <button class="btn btn-muted" type="button" disabled>Em análise</button>
                    <% } else { %>
                        <button class="btn btn-primary" type="button" id="openApprovalModal">Solicitar aprovação</button>
                    <% } %>
                </div>
            </div>
        <% } %>

        <section id="resumo" class="tab-content">
            <% const resumoVisits = (professionProfileCards || []).reduce((sum, card) => sum + Number(card.stats?.visits || 0), 0); %>
            <% const resumoClicks = (professionProfileCards || []).reduce((sum, card) => sum + Number(card.stats?.clicks || 0), 0); %>
            <div class="cards-grid">
                <div class="card metric"><div class="icon"><i class="fas fa-eye"></i></div><h3>Visitas nos últimos 30 dias</h3><div class="value"><%= resumoVisits %></div></div>
                <div class="card metric"><div class="icon"><i class="fab fa-whatsapp"></i></div><h3>Cliques em contratar</h3><div class="value"><%= resumoClicks %></div></div>
                <div class="card metric"><div class="icon"><i class="fas fa-phone"></i></div><h3>Contatos Recebidos</h3><div class="value"><%= contatosRecebidos %></div></div>
                <div class="card metric"><div class="icon"><i class="fas fa-star"></i></div><h3>Avaliação Média</h3><div class="value"><%= avaliacaoMedia %></div></div>
            </div>
            <% const resumoPortfolioCards = (professionProfileCards || []).filter(card => card.canEdit); %>
            <% const resumoPortfolioTotal = resumoPortfolioCards.reduce((sum, card) => sum + (card.portfolioPublished || card.portfolioPreview || card.portfolio || []).length, 0); %>
            <div class="summary-shortcuts" aria-label="Atalhos da Visão Geral">
                <button type="button" class="summary-shortcut" data-dashboard-shortcut="servicos"><span class="shortcut-top"><i class="fas fa-briefcase"></i><i class="fas fa-arrow-right shortcut-arrow"></i></span><span><strong>Meus Serviços</strong><span><%= contatosRecebidos %> contato(s) recebido(s)</span></span></button>
                <button type="button" class="summary-shortcut" data-dashboard-shortcut="profissoes"><span class="shortcut-top"><i class="fas fa-layer-group"></i><i class="fas fa-arrow-right shortcut-arrow"></i></span><span><strong>Minhas Profissões</strong><span><%= selectedCount %> profissão(ões) cadastrada(s)</span></span></button>
                <button type="button" class="summary-shortcut" data-dashboard-shortcut="portfolio"><span class="shortcut-top"><i class="fas fa-images"></i><i class="fas fa-arrow-right shortcut-arrow"></i></span><span><strong>Meu Portfólio</strong><span><%= resumoPortfolioTotal %> foto(s) publicada(s)</span></span></button>
                <button type="button" class="summary-shortcut" data-dashboard-shortcut="perfil"><span class="shortcut-top"><i class="fas fa-user-pen"></i><i class="fas fa-arrow-right shortcut-arrow"></i></span><span><strong>Meu Perfil</strong><span><%= basicProfileComplete ? 'Dados básicos concluídos' : 'Há dados básicos pendentes' %></span></span></button>
                <button type="button" class="summary-shortcut" data-dashboard-shortcut="planos"><span class="shortcut-top"><i class="fas fa-gem"></i><i class="fas fa-arrow-right shortcut-arrow"></i></span><span><strong>Meu Plano</strong><span><%= currentPlanName %></span></span></button>
            </div>
            <div class="panel" style="margin-top:16px">
                <h2>Desempenho por profissão</h2>
                <p class="small" style="margin-top:6px">Visitas do próprio profissional e pré-visualizações não entram nas métricas. Use esta visão para comparar quais serviços estão gerando mais interesse.</p>
                <div class="detail-grid performance-profession-grid" style="margin-top:12px">
                    <% (professionProfileCards || []).filter(card => card.canEdit).forEach(function(card){ %>
                        <button type="button" class="detail performance-profession-card" data-profession-shortcut-slot="<%= card.slot %>">
                            <strong><%= card.professionName %></strong>
                            <span><%= Number(card.stats?.visits || 0) %> visita(s) · <%= Number(card.stats?.clicks || 0) %> clique(s) · <%= Number(card.stats?.leads || 0) %> contato(s)</span>
                            <span class="performance-return">Possível retorno: <%= Number(card.stats?.estimatedReturn || 0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
                            <span class="performance-go">Editar esta profissão <i class="fas fa-arrow-right"></i></span>
                        </button>
                    <% }) %>
                </div>
            </div>
            <div class="panel lead-panel" id="pendingLeadsPanel" style="display:none;">
                <h2><i class="fas fa-bell"></i> Serviços pendentes</h2>
                <p class="small">Quando um cliente logado clicar em contratar, o contato aparece aqui. Marque se aceitou ou recusou para manter seu controle financeiro e histórico de segurança.</p>
                <div class="lead-list" id="pendingLeadsList"></div>
            </div>
            <div class="panel" style="margin-top:16px">
                <h2><i class="fas fa-clipboard-check"></i> Controle de serviços</h2>
                <p class="small" style="margin-top:7px">Use “Meus Serviços” para acompanhar os contatos recebidos e registrar se cada oportunidade foi aceita, recusada ou ainda precisa de resposta.</p>
                <div class="top-actions"><button type="button" class="btn btn-secondary" data-open-services><i class="fas fa-briefcase"></i> Abrir Meus Serviços</button></div>
            </div>
            <div class="summary-grid" style="margin-top:18px;">
                <div class="panel">
                    <h2>Andamento do perfil</h2>
                    <div class="detail-grid summary-profile-grid" style="margin-top:14px;">
                        <div class="detail"><strong>Dados básicos</strong><%= basicProfileComplete ? 'Concluídos' : 'Pendentes' %></div>
                        <div class="detail"><strong>Plano atual</strong><%= currentPlanName %></div>
                        <div class="detail"><strong>Profissões escolhidas</strong><%= selectedCount %></div>
                        <div class="detail portfolio-summary-detail"><strong>Portfólio por profissão</strong><% if (resumoPortfolioCards.length) { %><div style="display:grid;gap:5px"><% resumoPortfolioCards.forEach(function(card){ const count = (card.portfolioPublished || card.portfolioPreview || card.portfolio || []).length; %><span><%= card.professionName %>: <b><%= count %></b> imagem(ns)</span><% }) %></div><% } else { %>Nenhuma imagem cadastrada<% } %></div>
                    </div>
                </div>
                <div class="panel">
                    <h2>Dica para seu perfil</h2>
                    <p class="small" style="margin-top:8px;">Mantenha descrições, horários e fotos atualizados. Perfis completos ajudam o cliente a entender seu trabalho antes de entrar em contato.</p>
                    <div class="top-actions"><button type="button" class="btn btn-secondary" data-dashboard-shortcut="profissoes"><i class="fas fa-pen-to-square"></i> Revisar minhas profissões</button></div>
                </div>
            </div>
        </section>

        <section id="perfil" class="tab-content">
            <div class="panel">
                <h2>Meu Perfil Profissional</h2>
                <p class="small">Aqui fica a visão geral do perfil já salvo. Os ajustes rápidos podem ser feitos logo abaixo, sem precisar refazer tudo.</p>
                <div class="profile-photo-editor">
                    <form action="/profissional/foto/atualizar" method="POST" enctype="multipart/form-data" class="profile-photo-form" id="profilePhotoForm">
                        <label for="profilePhotoInput" class="profile-photo-preview" title="Clique para trocar a foto">
                            <% if (profissional?.users?.avatar_url) { %>
                                <img src="<%= profissional.users.avatar_url %>" alt="Foto de perfil">
                            <% } else { %>
                                <%= (fullName || 'P').charAt(0).toUpperCase() %>
                            <% } %>
                            <span>Trocar foto</span>
                        </label>
                        <input type="file" name="profile_photo" id="profilePhotoInput" accept="image/*" hidden>
                    </form>
                    <div class="profile-photo-copy">
                        <h3>Foto principal do profissional</h3>
                        <p>Esta é a foto que aparece nos cards, no perfil público e na identificação da dashboard. As imagens de serviço ficam separadas dentro de cada profissão.</p>
                        <button type="button" class="btn btn-secondary" onclick="document.getElementById('profilePhotoInput')?.click()"><i class="fas fa-camera"></i> Alterar foto</button>
                    </div>
                </div>
                <div class="detail-grid" style="margin-top:14px;">
                    <div class="detail"><strong>Nome</strong><%= profissional?.users?.full_name || fullName || 'Não informado' %></div>
                    <div class="detail"><strong>Telefone</strong><%= profissional.phone_number || 'Não informado' %></div>
                    <div class="detail"><strong>Cidade / Estado</strong><%= profissional.city ? `${profissional.city} - ${profissional.state || ''}` : 'Não informado' %></div>
                    <div class="detail"><strong>CEP</strong><%= profissional.cep || 'Não informado' %></div>
                </div>
                <div class="detail" style="margin-top:12px;"><strong>Conteúdo dos serviços</strong>Descrição, especialidades, disponibilidade e preços são ajustados separadamente em <a href="/profissional/dashboard?tab=profissoes" style="color:#ffb020">Minhas Profissões</a>.</div>
                <div class="detail" style="margin-top:12px;"><strong>Profissões escolhidas</strong>
                    <% if ((selectedProfessionSlots || []).length) { %>
                        <div class="chip-wrap" style="margin-top:8px">
                            <% selectedProfessionSlots.forEach(item => { %>
                                <span class="chip"><%= item.slot %>. <%= item.displayName %><% if (item.statusLabel) { %> · <%= item.statusLabel %><% } %></span>
                            <% }) %>
                        </div>
                    <% } else { %>
                        Ainda não definidas
                    <% } %>
                </div>
                <form action="/profissional/perfil/atualizar" method="POST" class="panel" style="margin-top:16px;padding:16px">
                    <h3>Ajustes rápidos do perfil</h3>
                    <div class="field-grid">
                        <div class="field"><label>Nome que aparece</label><input type="text" name="display_name" value="<%= profissional?.users?.full_name || fullName || '' %>"></div>
                        <div class="field"><label>WhatsApp</label><input type="text" inputmode="tel" name="phone_number" data-mask="phone" placeholder="(16) 99999-9999" value="<%= profissional.phone_number || '' %>"><span class="small">Este número é usado no botão “Contratar pelo WhatsApp”.</span></div>
                        <div class="field"><label>Telefone fixo (opcional)</label><input type="text" inputmode="tel" name="fixed_phone" data-mask="phone" placeholder="(16) 3252-0000" value="<%= profissional.fixed_phone || '' %>"></div>
                        <div class="field"><label>CEP <span class="small">(opcional)</span></label><div style="display:flex;gap:8px;flex-wrap:wrap"><input type="text" inputmode="numeric" name="cep" id="profileCepInput" data-mask="cep" maxlength="9" placeholder="15900-000" value="<%= profissional.cep || '' %>" style="flex:1;min-width:150px"><button type="button" class="btn btn-secondary" id="lookupProfileCep"><i class="fas fa-magnifying-glass-location"></i> Buscar</button></div><span class="small" id="profileCepStatus">O CEP não é obrigatório. Você pode preencher o endereço manualmente; quando informado, ele ajuda a deixar a localização mais precisa no Maps.</span><button type="button" class="btn btn-secondary" id="lookupCepByAddress" style="margin-top:7px;align-self:flex-start"><i class="fas fa-location-crosshairs"></i> Não sei meu CEP · buscar pelo endereço</button></div>
                        <div class="field"><label>Cidade</label><input type="text" name="city" id="profileCityInput" pattern="[A-Za-zÀ-ÿ\s]+" value="<%= profissional.city || '' %>"></div>
                        <div class="field"><label>Estado</label><input type="text" maxlength="2" name="state" id="profileStateInput" pattern="[A-Za-zÀ-ÿ\s]+" value="<%= profissional.state || '' %>"></div>
                        <div class="field"><label>Rua / Avenida (opcional)</label><input type="text" name="address_street" id="profileStreetInput" maxlength="160" value="<%= profissional.address_street || '' %>"></div>
                        <div class="field"><label>Número</label><input type="text" name="address_number" maxlength="20" value="<%= profissional.address_number || '' %>"></div>
                        <div class="field"><label>Bairro</label><input type="text" name="address_neighborhood" id="profileNeighborhoodInput" maxlength="120" value="<%= profissional.address_neighborhood || '' %>"></div>
                        <div class="field"><label>Complemento (opcional)</label><input type="text" name="address_complement" id="profileComplementInput" maxlength="120" placeholder="Sala, bloco, referência..." value="<%= profissional.address_complement || '' %>"></div>
                    </div>
                    <label style="display:flex;align-items:flex-start;gap:9px;margin-top:14px;padding:12px 14px;border:1px solid #30343a;border-radius:12px;background:#111318;color:#fff"><input type="checkbox" name="show_full_address" style="margin-top:3px" <%= profissional.show_full_address ? 'checked' : '' %>><span><strong>Mostrar meu endereço profissional completo no perfil público</strong><br><span class="small">Se ficar desmarcado, o cliente continuará vendo somente sua cidade e estado.</span></span></label>
                    <div class="profession-help" style="margin-top:12px"><strong>Dados do serviço ficam em Minhas Profissões.</strong> Assim você não corre o risco de alterar Marceneiro e, sem perceber, mudar também Analista de Sistemas.</div>
                    <div class="top-actions"><button type="button" class="btn btn-secondary" onclick="cancelProfileEdit()">Cancelar edição</button><button type="submit" class="btn btn-primary">Salvar ajustes do perfil</button><button type="button" class="btn btn-danger" onclick="openDeleteProfileModal()">Excluir perfil</button></div>
                </form>
            </div>
        </section>


        <section id="profissoes" class="tab-content">
            <div class="panel">
                <h2>Minhas Profissões</h2>
                <p class="small" style="margin-top:6px;line-height:1.55">Selecione a profissão que deseja editar. Aqui ficam somente as informações do serviço: descrição, especialidades, disponibilidade e preço. As fotos ficam concentradas em “Meu Portfólio” para evitar alterações duplicadas ou confusas.</p>
                <button type="button" class="btn btn-secondary help-toggle" onclick="toggleQuickGuide()"><i class="fas fa-circle-info"></i> Ver guia rápido desta área</button>
                <div class="quick-guide" id="quickGuideProfessions">
                    <strong>Guia rápido:</strong> esta área organiza um mini-perfil para cada profissão aprovada.
                    <ol>
                        <li>Escolha a profissão na lista.</li>
                        <li>Revise descrição, especialidades, disponibilidade e preço.</li>
                        <li>Clique em “Visualizar antes de publicar”: a prévia usa exatamente o que está preenchido na tela, sem salvar nem contar visita.</li>
                        <li>Se gostar do resultado, publique pela própria prévia ou volte para continuar editando.</li>
                        <li>Para adicionar/remover fotos, use “Meu Portfólio”.</li>
                    </ol>
                </div>
                <% const professionCards = Array.isArray(professionProfileCards) ? professionProfileCards : []; %>
                <% const editableProfessionCards = professionCards.filter(card => card.canEdit); %>
                <% const selectedSlotFromQuery = Number(selectedProfessionSlot || 0); %>
                <% const firstEditableCard = professionCards.find(card => Number(card.slot) === selectedSlotFromQuery) || editableProfessionCards[0] || professionCards[0] || null; %>
                <% const pendingProfessionCards = professionCards.filter(card => !card.canEdit); %>
                <% if (!professionCards.length) { %>
                    <div class="detail" style="margin-top:14px"><strong>Nenhuma profissão configurada</strong>Volte ao plano/cadastro para escolher suas profissões.</div>
                <% } else { %>
                    <div class="profession-selector-shell">
                        <div>
                            <label for="professionEditorSelect">Escolha a profissão</label>
                            <select id="professionEditorSelect">
                                <% professionCards.forEach(function(card) { %>
                                    <option value="profession-pane-<%= card.slot %>" <%= firstEditableCard && Number(firstEditableCard.slot) === Number(card.slot) ? 'selected' : '' %>>
                                        <%= card.professionName %><% if (!card.canEdit) { %> · em análise<% } %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="profession-help">
                            <strong>Como funciona:</strong> a foto principal fica no Meu Perfil. Aqui você organiza cada profissão separadamente. Exemplo: Pedreiro mostra obras/reformas; Eletricista mostra instalações elétricas.
                        </div>
                    </div>
                    <% if (pendingProfessionCards.length) { %>
                        <div class="analysis-list">
                            <% pendingProfessionCards.forEach(function(card) { %>
                                <span class="analysis-chip"><i class="fas fa-clock"></i> <%= card.professionName %> em análise pelo ADM</span>
                            <% }) %>
                        </div>
                    <% } %>

                    <% professionCards.forEach(function(card) { %>
                        <% const isDefaultPane = firstEditableCard && Number(firstEditableCard.slot) === Number(card.slot); %>
                        <% const profileUrl = `/perfil/${profissional.user_id || profissional.id}?categoria=${encodeURIComponent(card.professionSlug || card.professionName || 'profissional')}`; %>
                        <div class="profession-editor-pane <%= isDefaultPane ? '' : 'hidden-pane' %>" id="profession-pane-<%= card.slot %>">
                            <div class="mobile-profession-context"><span><i class="fas fa-pen-to-square"></i> Editando agora</span><strong><%= card.professionName %></strong></div>
                            <div class="profession-editor-top">
                                <div>
                                    <h3><%= card.professionName %></h3>
                                    <p class="small">O cliente verá este conteúdo ao abrir seu perfil como <strong><%= card.professionName %></strong>.</p>
                                </div>
                                <% if (card.canEdit) { %>
                                    <span class="profile-status-pill active"><i class="fas fa-check-circle"></i> Publicável</span>
                                <% } else { %>
                                    <span class="profile-status-pill pending"><i class="fas fa-clock"></i> Em análise pelo ADM</span>
                                <% } %>
                            </div>
                            <div class="editing-notice">
                                <div><strong>Você está editando:</strong> <%= card.professionName %><br><span class="small">Descrição, horários, especialidades e preços podem ser ajustados aqui. Fotos ficam em “Meu Portfólio”; troca de profissão ou profissão nova passa pelo ADM.</span></div>
                                <% if (card.canEdit) { %><span class="profile-status-pill active"><i class="fas fa-pen-to-square"></i> edição liberada</span><% } %>
                            </div>
                            <% if (selectedSlotFromQuery && Number(selectedSlotFromQuery) === Number(card.slot) && flashSuccess) { %><div class="inline-pane-flash success"><%= flashSuccess %></div><% } %>
                            <% if (selectedSlotFromQuery && Number(selectedSlotFromQuery) === Number(card.slot) && flashError) { %><div class="inline-pane-flash error"><%= flashError %></div><% } %>

                            <% if (!card.canEdit) { %>
                                <p class="small">Esta profissão ainda depende da análise do ADM. Ela não aparece para clientes e não pode receber portfólio público até ser aprovada.</p>
                            <% } else { %>
                                <% const stats = card.stats || {}; %>
                                <% const estimatedReturn = Number(stats.estimatedReturn || 0).toFixed(2).replace('.', ','); %>
                                <div class="profession-stats-grid">
                                    <div class="profession-stat"><strong>Visitas 30 dias</strong><span><%= stats.visits || 0 %></span></div>
                                    <div class="profession-stat"><strong>Cliques em contratar</strong><span><%= stats.clicks || 0 %></span></div>
                                    <div class="profession-stat"><strong>Contatos gerados</strong><span><%= stats.leads || 0 %></span></div>
                                    <div class="profession-stat"><strong>Possível retorno</strong><span>R$ <%= estimatedReturn %></span></div>
                                </div>
                                <p class="small" style="margin-top:-4px;margin-bottom:12px">A estimativa usa os contatos marcados como aceitos vezes o preço médio informado; se não houver preço médio, usa a taxa de visita. Visitas do próprio profissional e pré-visualizações não entram na contagem.</p>

                                <form action="/profissional/profissoes/<%= card.slot %>/atualizar" method="POST" class="profession-update-form" data-slot="<%= card.slot %>" data-current-availability="<%= card.availability || '' %>">
                                    <input type="hidden" name="portfolio_order" class="portfolio-order-input" value='<%- JSON.stringify((card.portfolioPreview || card.portfolio || []).map(item => String(item.id || "")).filter(Boolean)) %>'>
                                    <div class="profession-draft-banner" data-draft-status data-state="published"><i class="fas fa-circle-check"></i><span>Tudo publicado. Se você editar algo, o Contrataê salva um rascunho automaticamente neste dispositivo.</span></div>
                                    <div class="field-grid">
                                        <div class="field"><label>Apresentação / mini biografia desta profissão</label><textarea name="description" placeholder="Conte brevemente quem você é, sua experiência e como trabalha nesta profissão"><%= card.description || '' %></textarea><small class="small">É o texto principal que o cliente lê em “Sobre o Profissional”.</small></div>
                                        <div class="field"><label>Especialidades desta profissão</label><textarea name="specialties" placeholder="Ex: alvenaria, porcelanato, reforma, acabamento"><%= card.specialties || '' %></textarea></div>
                                    </div>

                                    <div class="availability-editor" data-availability-editor>
                                        <input type="hidden" name="availability_summary" class="availability-summary" value="<%= card.availability || '' %>">
                                        <div class="availability-editor-head">
                                            <div>
                                                <strong><i class="fas fa-calendar-days"></i> Disponibilidade desta profissão</strong>
                                                <p class="small">Mesmo padrão do cadastro: marque os dias e escolha horários em intervalos de 30 minutos.</p>
                                            </div>
                                            <span class="draft-state"><i class="fas fa-pen"></i> edição automática</span>
                                        </div>
                                        <div class="availability-days-row">
                                            <% ['Seg','Ter','Qua','Qui','Sex'].forEach(function(day){ %>
                                                <label class="availability-chip"><input type="checkbox" name="working_days" value="<%= day %>"> <%= day %></label>
                                            <% }) %>
                                            <label class="availability-chip"><input type="checkbox" name="available_24h" class="availability-24h-toggle"> Atendimento 24h</label>
                                        </div>
                                        <div class="availability-24h-panel hidden-pane">
                                            <strong>Atendimento 24h</strong>
                                            <p class="small">Marque apenas os dias em que você realmente consegue atender 24 horas.</p>
                                            <div class="availability-days-row" style="margin-top:9px;margin-bottom:0">
                                                <label class="availability-chip"><input type="checkbox" name="available_24h_all_days" class="availability-24h-all"> Todos os dias</label>
                                                <% ['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'].forEach(function(day){ %>
                                                    <label class="availability-chip"><input type="checkbox" name="working_days_24h" value="<%= day %>"> <%= day %></label>
                                                <% }) %>
                                                <label class="availability-chip"><input type="checkbox" name="available_24h_holidays"> Feriados</label>
                                            </div>
                                        </div>
                                        <div class="availability-time-grid">
                                            <div class="field"><label>Início do horário padrão</label><select name="availability_start" class="availability-start-select"></select></div>
                                            <div class="field"><label>Fim do horário padrão</label><select name="availability_end" class="availability-end-select"></select></div>
                                        </div>
                                        <div class="special-day-grid-dashboard">
                                            <% [['saturday','Sábado','same'],['sunday','Domingo','no'],['holiday','Feriado','no']].forEach(function(def){ %>
                                                <div class="special-day-dashboard" data-special-day="<%= def[0] %>">
                                                    <div class="field"><label><%= def[1] %></label><select name="<%= def[0] %>_service_mode" class="special-day-mode">
                                                        <option value="same">Mesmo horário padrão</option>
                                                        <option value="custom">Horário diferente</option>
                                                        <option value="no">Não atende</option>
                                                    </select></div>
                                                    <div class="special-time-pair hidden-pane">
                                                        <div class="field"><label>Início</label><select name="<%= def[0] %>_start" class="special-start-select"></select></div>
                                                        <div class="field"><label>Fim</label><select name="<%= def[0] %>_end" class="special-end-select"></select></div>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                        <div class="availability-summary-preview"><strong>Como aparecerá:</strong> <span class="availability-summary-text"><%= card.availability || 'Defina seus dias e horários.' %></span></div>
                                    </div>

                                    <div class="price-editor-grid">
                                        <div class="price-option-card">
                                            <label class="price-toggle-row"><input type="checkbox" name="service_fee_enabled" class="service-fee-toggle" <%= card.priceValue !== '' && card.priceValue !== null && card.priceValue !== undefined ? 'checked' : '' %>> <strong>Cobro taxa de visita</strong></label>
                                            <div class="field service-fee-field"><label>Valor da taxa de visita</label><input type="text" inputmode="decimal" class="currency-input" name="price_value" value="<%= card.priceValue || '' %>" placeholder="Ex: 35,00"><small class="small">Somente números. Desmarque se não cobrar visita.</small></div>
                                        </div>
                                        <div class="price-option-card">
                                            <div class="field"><label>Preço médio do serviço <span class="small">(opcional)</span></label><input type="text" inputmode="decimal" class="currency-input" name="average_price" value="<%= card.averagePrice || '' %>" placeholder="Ex: 180,00"><small class="small">Ajuda o cliente a ter uma referência inicial; não substitui o orçamento.</small></div>
                                        </div>
                                    </div>

                                    <div class="profession-actions-row">
                                        <a class="btn btn-secondary published-profile-view-link" href="/perfil/<%= profissional.user_id || profissional.id %>?categoria=<%= encodeURIComponent(card.professionSlug || card.professionName || 'profissional') %>&ownerView=1&returnTab=profissoes&slot=<%= card.slot %>"><i class="fas fa-window-maximize"></i> Ver publicado atual</a>
                                        <button type="submit" formaction="/profissional/profissoes/<%= card.slot %>/preview" class="btn btn-secondary preview-profession-btn" data-requires-draft="1" disabled title="Faça uma alteração para liberar a pré-visualização"><i class="fas fa-eye"></i> Visualizar antes de publicar</button>
                                        <button type="submit" class="btn btn-primary publish-profession-btn" disabled title="Faça uma alteração antes de publicar"><i class="fas fa-upload"></i> Publicar alterações</button>
                                        <a href="/profissional/dashboard?tab=portfolio&slot=<%= card.slot %>" class="btn btn-secondary draft-preserving-link" data-draft-slot="<%= card.slot %>"><i class="fas fa-images"></i> Gerenciar fotos desta profissão</a>
                                    </div>
                                    <p class="small profession-save-note"><i class="fas fa-circle-info"></i> “Visualizar” não publica e não conta como visita. A publicação só acontece quando você confirmar.</p>
                                </form>

                                <div class="portfolio-summary-link">
                                    <div>
                                        <strong><i class="fas fa-images"></i> Portfólio de <%= card.professionName %></strong>
                                        <span class="small"><%= (card.portfolioPreview || card.portfolio || []).length %> imagem(ns) no portfólio desta profissão. Fotos são gerenciadas somente em “Meu Portfólio”.</span>
                                    </div>
                                    <a href="/profissional/dashboard?tab=portfolio&slot=<%= card.slot %>" class="btn btn-secondary draft-preserving-link" data-draft-slot="<%= card.slot %>">Abrir portfólio</a>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </section>

        <section id="portfolio" class="tab-content">
            <div class="panel">
                <h2>Meu Portfólio</h2>
                <p class="small" style="margin:6px 0 14px;line-height:1.55">As fotos dos seus trabalhos ficam aqui, separadas por profissão. Trocar a profissão abaixo muda o portfólio imediatamente — sem mandar você para outra área da dashboard.</p>
                <div class="portfolio-context-box">
                    <strong style="color:#ffb020">Qual portfólio você quer editar?</strong>
                    <div class="portfolio-context-actions" style="margin-top:10px">
                        <div><label class="small">Profissão</label><br>
                            <select id="portfolioProfessionSelect">
                                <% editableProfessionCards.forEach(function(card){ %>
                                    <option value="portfolio-pane-<%= card.slot %>" data-slot="<%= card.slot %>" <%= Number(selectedProfessionSlot || 0) === Number(card.slot) ? 'selected' : '' %>><%= card.professionName %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <p class="small" style="margin-top:8px"><i class="fas fa-user-circle"></i> A foto do rosto continua em “Meu Perfil”. Aqui entram apenas fotos de trabalhos/serviços.</p>
                </div>

                <% editableProfessionCards.forEach(function(card, idx){ %>
                    <% const showPortfolioPane = Number(selectedProfessionSlot || 0) ? Number(selectedProfessionSlot) === Number(card.slot) : idx === 0; %>
                    <% const editorPortfolio = Array.isArray(card.portfolio) ? card.portfolio : []; %>
                    <% const previewPortfolio = Array.isArray(card.portfolioPreview) ? card.portfolioPreview : editorPortfolio; %>
                    <% const portfolioDraftPending = Boolean(card.portfolioHasDraft); %>
                    <div class="portfolio-profession-pane <%= showPortfolioPane ? '' : 'hidden-pane' %>" id="portfolio-pane-<%= card.slot %>">
                        <div class="portfolio-pane-header">
                            <div><h3>Portfólio de <%= card.professionName %></h3><p class="small">Até 10 imagens de trabalhos/serviços. A foto de perfil é separada e não entra neste limite. Fotos, ordem, remoções e legendas ficam em rascunho até você publicar.</p></div>
                            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end">
                                <span class="profile-status-pill active"><%= previewPortfolio.length %>/10 imagens</span>
                                <button type="button" class="btn btn-secondary return-to-profession-editor" data-slot="<%= card.slot %>"><i class="fas fa-arrow-left"></i> Voltar para editar esta profissão</button>
                                <a class="btn btn-secondary published-profile-view-link" href="/perfil/<%= profissional.user_id || profissional.id %>?categoria=<%= encodeURIComponent(card.professionSlug || card.professionName || 'profissional') %>&ownerView=1&returnTab=portfolio&slot=<%= card.slot %>"><i class="fas fa-eye"></i> Ver perfil publicado atual</a>
                            </div>
                        </div>

                        <div class="portfolio-context-confirm" data-portfolio-context-confirm="<%= card.slot %>" aria-live="polite"><i class="fas fa-location-dot"></i><span>Você está editando o portfólio de <strong><%= card.professionName %></strong>. Fotos desta tela afetam somente esta profissão.</span></div>
                        <div id="portfolio-workspace-<%= card.slot %>"></div>
                        <% if (selectedSlotFromQuery && Number(selectedSlotFromQuery) === Number(card.slot) && flashSuccess && activeTab === 'portfolio') { %><div class="portfolio-inline-flash success"><%= flashSuccess %></div><% } %>
                        <% if (selectedSlotFromQuery && Number(selectedSlotFromQuery) === Number(card.slot) && flashError && activeTab === 'portfolio') { %><div class="portfolio-inline-flash error"><%= flashError %></div><% } %>
                        <div class="portfolio-draft-banner <%= portfolioDraftPending ? 'pending' : '' %>" data-portfolio-draft-banner="<%= card.slot %>" data-photo-draft="<%= portfolioDraftPending ? '1' : '0' %>" data-info-draft="0">
                            <div>
                                <% if (portfolioDraftPending) { %>
                                    <strong data-portfolio-draft-title><i class="fas fa-cloud"></i> Você tem mudanças de fotos ainda não publicadas</strong>
                                    <span class="small" data-portfolio-draft-copy>A prévia mostra suas informações editadas + estas fotos. O perfil público continua como está até você confirmar.</span>
                                <% } else { %>
                                    <strong data-portfolio-draft-title><i class="fas fa-circle-check"></i> Portfólio publicado</strong>
                                    <span class="small" data-portfolio-draft-copy>Escolha uma foto para criar um rascunho. O envio começa automaticamente.</span>
                                <% } %>
                            </div>
                            <div class="portfolio-draft-banner-actions">
                                <button type="button" class="btn btn-preview-strong preview-from-portfolio" data-slot="<%= card.slot %>" <%= portfolioDraftPending ? '' : 'disabled' %> title="<%= portfolioDraftPending ? 'Visualizar as alterações antes de publicar' : 'Faça uma alteração para liberar a pré-visualização' %>"><i class="fas fa-eye"></i> Visualizar antes de publicar</button>
                                <button type="button" class="btn <%= portfolioDraftPending ? 'btn-primary' : 'btn-secondary' %> publish-from-portfolio" data-slot="<%= card.slot %>" <%= portfolioDraftPending ? '' : 'disabled' %>><i class="fas fa-upload"></i> Salvar e publicar tudo</button>
                            </div>
                        </div>

                        <form action="/profissional/profissoes/<%= card.slot %>/portfolio/adicionar" method="POST" enctype="multipart/form-data" class="portfolio-upload-card profession-upload-form" data-slot="<%= card.slot %>">
                            <input class="visually-hidden-file profession-file-input" id="portfolio-file-<%= card.slot %>" type="file" name="profession_portfolio_image" accept="image/jpeg,image/png,image/webp" required>
                            <button type="button" class="btn btn-secondary choose-portfolio-image" data-input="portfolio-file-<%= card.slot %>"><i class="fas fa-image"></i> Escolher nova imagem</button>
                            <span class="profession-file-name">Nenhuma imagem selecionada.</span>
                            <span class="portfolio-upload-hint"><i class="fas fa-bolt"></i> Ao escolher, o Contrataê envia automaticamente e coloca a foto no rascunho.</span>
                            <button type="submit" class="visually-hidden-file auto-portfolio-submit" tabindex="-1" aria-hidden="true">Enviar</button>
                            <div class="profession-preview">
                                <img alt="Prévia da nova imagem"><div><strong>Enviando imagem...</strong><br><span class="small">Aguarde. Ela aparecerá abaixo como “Nova · não publicada”.</span></div>
                            </div>
                        </form>
                        <div class="portfolio-slots profession-portfolio-grid">
                            <% for (let i = 0; i < Math.max(10, editorPortfolio.length); i++) { const item = editorPortfolio[i]; %>
                                <% if (item) { const isNewDraft = item.is_published === false; const pendingDelete = item.pending_delete === true; const itemCaption = String(item.draft_caption ?? item.caption ?? '').trim(); %>
                                    <div class="slot <%= isNewDraft ? 'portfolio-draft-new' : '' %> <%= pendingDelete ? 'portfolio-pending-delete' : '' %>" data-portfolio-item-id="<%= item.id || '' %>" data-portfolio-pending-delete="<%= pendingDelete ? '1' : '0' %>" data-slot="<%= card.slot %>">
                                        <% if (item.profession_profile_id && !pendingDelete) { %><div class="portfolio-order-actions"><button type="button" class="portfolio-order-btn" data-portfolio-move="-1" title="Mover imagem para a esquerda"><i class="fas fa-arrow-left"></i></button><button type="button" class="portfolio-order-btn" data-portfolio-move="1" title="Mover imagem para a direita"><i class="fas fa-arrow-right"></i></button></div><% } %>
                                        <img src="<%= item.image_url %>" alt="Imagem <%= i+1 %> de <%= card.professionName %>">
                                        <% if (itemCaption && !pendingDelete) { %><div class="portfolio-caption-preview"><%= itemCaption %></div><% } %>
                                        <% if (isNewDraft) { %><span class="portfolio-state-badge new">Nova · não publicada</span><% } %>
                                        <% if (pendingDelete) { %><span class="portfolio-state-badge remove">Será removida ao publicar</span><% } %>
                                        <div class="slot-actions">
                                            <% if (pendingDelete) { %>
                                                <form action="/profissional/profissoes/portfolio/desfazer-remocao" method="POST">
                                                    <input type="hidden" name="id" value="<%= item.id %>"><input type="hidden" name="slot" value="<%= card.slot %>">
                                                    <button class="slot-action-btn slot-action-undo" type="submit"><i class="fas fa-rotate-left"></i><span class="action-label"> Desfazer</span></button>
                                                </form>
                                            <% } else if (item.profession_profile_id) { %>
                                                <button type="button" class="slot-action-btn slot-action-caption edit-portfolio-caption" data-id="<%= item.id %>" data-slot="<%= card.slot %>" data-caption="<%= itemCaption %>"><i class="fas fa-pen"></i><span class="action-label"> Legenda</span></button>
                                                <form action="/profissional/profissoes/portfolio/remover" method="POST" class="portfolio-remove-form">
                                                    <input type="hidden" name="id" value="<%= item.id %>"><input type="hidden" name="slot" value="<%= card.slot %>">
                                                    <button class="slot-action-btn slot-action-remove" type="submit"><i class="fas fa-trash"></i><span class="action-label"> Remover</span></button>
                                                </form>
                                            <% } else { %>
                                                <span class="legacy-photo-badge">Imagem inicial</span>
                                            <% } %>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <button type="button" class="slot empty portfolio-empty-trigger" data-input="portfolio-file-<%= card.slot %>">+ adicionar foto<br>de <%= card.professionName %></button>
                                <% } %>
                            <% } %>
                        </div>
                        <% if (card.legacyFallback) { %>
                            <div class="portfolio-info-note"><i class="fas fa-circle-info"></i> Estas são as imagens iniciais do cadastro. Ao adicionar a primeira foto específica desta profissão, o Contrataê preservará a base para não fazer fotos sumirem do perfil.</div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </section>

<section id="planos" class="tab-content">
            <div class="panel">
                <h2>Meu Plano</h2>
                <p class="small">Acompanhe aqui o plano vinculado à sua conta e quantas profissões estão liberadas no seu perfil.</p>
                <div class="plan-current-banner">
                    <i class="fas fa-circle-check" aria-hidden="true"></i>
                    <div><strong><%= currentPlanName %></strong><span>Plano atual do seu perfil profissional.</span></div>
                </div>
                <div class="detail-grid" style="margin-top:14px;">
                    <div class="detail"><strong>Profissões liberadas</strong><%= selectedCount || 1 %></div>
                    <div class="detail"><strong>Status do perfil</strong><%= isApproved ? 'Aprovado e publicado' : (approvalPending ? 'Em análise' : (profileReadyForApproval ? 'Pronto para análise' : 'Em montagem')) %></div>
                    <div class="detail"><strong>Valor informado</strong>R$ <%= Number(profissional.plan_price || profissional.payment_value || 0).toFixed(2).replace('.', ',') %></div>
                    <div class="detail"><strong>Período</strong><%= profissional.plan_duration_months || 1 %> mês(es)</div>
                </div>
            </div>
        </section>

        <section id="pagamentos" class="tab-content">
            <div class="panel">
                <h2>Histórico de Pagamentos</h2>
                <div class="table-wrap" style="margin-top:14px;">
                    <table>
                        <thead><tr><th>Data</th><th>Plano</th><th>Valor</th><th>Status</th></tr></thead>
                        <tbody>
                            <% if ((pagamentos || []).length) { %>
                                <% pagamentos.forEach(pag => { %>
                                    <tr>
                                        <td><%= new Date(pag.payment_date).toLocaleDateString('pt-BR') %></td>
                                        <td><%= pag.plans?.name || 'Plano' %></td>
                                        <td>R$ <%= pag.amount %></td>
                                        <td><span class="badge <%= pag.status %>"><%= pag.status === 'completed' ? 'Concluído' : 'Pendente' %></span></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="4" class="small">Nenhum pagamento registrado ainda.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section id="servicos" class="tab-content">
            <div class="panel">
                <h2>Meus Serviços</h2>
                <p class="small">Aqui ficam os contatos recebidos pelo botão “Contratar”. Use esta área para lembrar se aceitou, recusou ou precisa responder o cliente.</p>
                <div class="lead-list" id="servicesLeadsList"><p class="small">Carregando contatos...</p></div>
            </div>
        </section>
        <section id="avaliacoes" class="tab-content">
            <div class="panel">
                <% const visibleProfessionalReviews = (avaliacoes || []).filter(r => String(r.status || 'visible').toLowerCase() === 'visible'); %>
                <div class="reviews-dashboard-head">
                    <div>
                        <h2>Avaliações</h2>
                        <p class="small">Veja a reputação que os clientes encontram no seu perfil público. As avaliações ajudam outros clientes a conhecer a experiência de quem já contratou você.</p>
                    </div>
                </div>
                <div class="reviews-overview">
                    <div class="review-overview-card"><span>Avaliação média</span><strong><i class="fas fa-star" style="font-size:.7em"></i> <%= avaliacaoMedia %></strong></div>
                    <div class="review-overview-card"><span>Avaliações publicadas</span><strong><%= visibleProfessionalReviews.length %></strong></div>
                </div>
                <% if (visibleProfessionalReviews.length) { %>
                    <div class="professional-review-list">
                        <% visibleProfessionalReviews.slice(0, 8).forEach(review => { %>
                            <article class="professional-review-card">
                                <div class="professional-review-top">
                                    <strong>Cliente verificado</strong>
                                    <span class="professional-review-stars" aria-label="<%= Number(review.rating || 0) %> de 5 estrelas">
                                        <% for (let i = 0; i < 5; i++) { %><i class="fas fa-star" style="opacity:<%= i < Number(review.rating || 0) ? 1 : .25 %>"></i><% } %>
                                    </span>
                                </div>
                                <p><%= review.comment || 'Avaliação sem comentário.' %></p>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="professional-review-empty"><i class="fas fa-star"></i><strong>Ainda não há avaliações publicadas.</strong><br><span class="small">Quando clientes avaliarem seu atendimento, elas aparecerão aqui e no perfil público.</span></div>
                <% } %>
            </div>
        </section>
    </main>
</div>

<nav class="mobile-dashboard-bottom-nav" aria-label="Navegação principal da Área Profissional">
    <button type="button" data-mobile-tab="resumo"><i class="fas fa-chart-line"></i><span>Visão</span></button>
    <button type="button" data-mobile-tab="servicos"><i class="fas fa-briefcase"></i><span>Serviços</span></button>
    <button type="button" data-mobile-tab="profissoes"><i class="fas fa-layer-group"></i><span>Profissões</span></button>
    <button type="button" data-mobile-tab="portfolio"><i class="fas fa-images"></i><span>Portfólio</span></button>
    <button type="button" data-mobile-more><i class="fas fa-bars"></i><span>Mais</span></button>
</nav>
