        const url=new URL(window.location.href); url.searchParams.set('tab','profissoes'); url.searchParams.set('slot',slot); history.replaceState({},'',url.pathname+url.search);
        openTab('profissoes',{slot}); setTimeout(()=>document.getElementById(`profession-pane-${slot}`)?.scrollIntoView({behavior:'smooth',block:'start'}),80);
    }));

    document.querySelectorAll('.profession-update-form, .profession-upload-form').forEach(form => {
        form.addEventListener('submit', (ev) => {
            form.classList.add('is-busy');
            const button = ev.submitter || form.querySelector('button[type="submit"]');
