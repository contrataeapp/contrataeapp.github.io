    <div class="modal-actions-local">
      <form action="/profissional/solicitar-aprovacao" method="POST" enctype="multipart/form-data" id="approvalRequestForm">
        <div class="field" style="margin-top:14px;text-align:left">
            <label>Comprovante de pagamento</label>
            <input type="file" name="payment_proof" id="paymentProofInput" accept="image/*,application/pdf">
            <div class="help">Você pode anexar o comprovante aqui ou marcar abaixo que enviou pelo WhatsApp.</div>
        </div>
        <label style="display:flex;align-items:center;gap:8px;margin-top:12px;color:#fff"><input type="checkbox" name="payment_sent_whatsapp" id="paymentWhatsappCheck"> Enviei o comprovante pelo WhatsApp</label>
        <div class="modal-actions-local">
            <button type="button" class="btn btn-secondary" id="closeApprovalModal">Cancelar</button>
            <button class="btn btn-primary" type="submit" id="approvalSubmitBtn" disabled>Enviar para análise</button>
