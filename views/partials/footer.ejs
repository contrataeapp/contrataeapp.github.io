<footer>
    <div class="footer-partners-area" id="parceiros-area">
        <div class="container">
            <h4 style="color: #ffa500; text-align: center; margin-bottom: 10px; font-size: 1rem;">Nossos Parceiros</h4>
            <section class="carousel-section footer-carousel" id="carousel-baixo">
                <div class="carousel-container">
                    <% const bannersRodape = typeof banners !== 'undefined' ? banners.filter(b => Number(b.posicao) === 2 || (b.position === 'home' && Number(b.order) >= 100 && Number(b.order) < 200)).sort((a,b)=>Number(a.order || 0)-Number(b.order || 0)) : []; %>

                    <% if (bannersRodape.length > 0) { %>
                        <% bannersRodape.forEach(function(banner, index) { %>
                            <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                <a href="#" class="trigger-modal" data-link="<%= banner.link_destino || banner.link_destination || '#' %>">
                                    <img src="<%= banner.imagem_url || banner.image_url %>" alt="<%= banner.titulo || banner.title || 'Parceiro' %>" style="width:100%; height:100%; object-fit:fill;">
                                </a>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="carousel-item active">
                            <a href="#" class="trigger-modal" data-link="https://wa.me/5516996484492?text=Olá, vi o anúncio do Ponto Forte no Contrataê e gostaria de mais informações!">
                                <img src="/imagens/parceiros/ponto_forte.png" alt="Ponto Forte" style="width:100%; height:100%; object-fit:fill;">
                            </a>
                        </div>
                    <% } %>

                    <button class="carousel-btn prev-btn"><i class="fas fa-chevron-left"></i></button>
                    <button class="carousel-btn next-btn"><i class="fas fa-chevron-right"></i></button>
                    <div class="carousel-dots">
                        <% if (bannersRodape && bannersRodape.length > 0) { %>
                            <% bannersRodape.forEach(function(_, index) { %>
                                <span class="dot <%= index === 0 ? 'active' : '' %>"></span>
                            <% }); %>
                        <% } else { %>
                            <span class="dot active"></span>
                        <% } %>
                    </div>
                </div>
            </section>
        </div>
    </div>
    <div class="footer-copyright-bar">
        <div class="container copyright-flex">
            <p>&copy; 2026 Contrataê</p>
            <div class="footer-links">
                <a href="/avaliacao">Avaliação</a> | 
                <a href="/contato">Sobre Nós</a> | 
                <a href="/termos-de-uso">Termos</a>
            </div>
            <% const ps = (typeof platformSettings !== 'undefined' && platformSettings) ? platformSettings : {}; %>
            <% const hasSocial = (ps.instagram_active && ps.instagram_url) || (ps.facebook_active && ps.facebook_url) || (ps.x_active && ps.x_url) || (ps.whatsapp_active && ps.whatsapp_url) || ps.contact_email; %>
            <% if (hasSocial) { %>
            <div class="footer-social-links" aria-label="Canais oficiais do Contrataê">
                <% if (ps.instagram_active && ps.instagram_url) { %><a href="<%= ps.instagram_url %>" target="_blank" rel="noopener" aria-label="Instagram do Contrataê"><i class="fab fa-instagram"></i></a><% } %>
                <% if (ps.facebook_active && ps.facebook_url) { %><a href="<%= ps.facebook_url %>" target="_blank" rel="noopener" aria-label="Facebook do Contrataê"><i class="fab fa-facebook-f"></i></a><% } %>
                <% if (ps.x_active && ps.x_url) { %><a href="<%= ps.x_url %>" target="_blank" rel="noopener" aria-label="X do Contrataê"><i class="fab fa-x-twitter"></i></a><% } %>
                <% if (ps.whatsapp_active && ps.whatsapp_url) { %><a href="<%= ps.whatsapp_url %>" target="_blank" rel="noopener" aria-label="WhatsApp do Contrataê"><i class="fab fa-whatsapp"></i></a><% } %>
                <% if (ps.contact_email) { %><a href="mailto:<%= ps.contact_email %>" aria-label="E-mail do Contrataê"><i class="fas fa-envelope"></i></a><% } %>
            </div>
            <% } %>
        </div>
    </div>
</footer>

<div id="external-link-modal" class="modal-overlay">
    <div class="modal-box">
        <h3>Você está saindo do Contrataê</h3>
        <p id="modal-msg">Você será redirecionado(a) para o site de nosso parceiro.</p>
        <p class="modal-link-preview" id="modal-link-dest"></p>
        <div class="modal-buttons">
            <button id="cancel-link" class="button secondary-button">Cancelar</button>
            <button id="confirm-link" class="button primary-button">Continuar</button>
        </div>
    </div>
</div>

<% if (!(typeof ownerPublishedView !== 'undefined' && ownerPublishedView) && !(typeof currentPage !== 'undefined' && currentPage === 'instalar')) { %>
<style>
